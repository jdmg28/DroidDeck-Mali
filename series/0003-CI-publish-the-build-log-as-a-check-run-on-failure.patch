From 3c6ff8907579b522b81b4ff57e3728cafcdace2a Mon Sep 17 00:00:00 2001
From: Arena Agent <agent@arena.ai>
Date: Sat, 10 Oct 2026 01:07:43 +0000
Subject: [PATCH 03/29] CI: publish the build log as a check run on failure

The logs host is unreachable from where this branch is being worked on, so a
failed build would otherwise be a dead end: the only thing visible is
'Process completed with exit code 1'. The tail of the build plus every line
Gradle marked as an error now goes out through a check run, which is readable
from the API.

Co-authored-by: arena-agent <297053741+arena-agent@users.noreply.github.com>
---
 .github/workflows/gpu-guard-ci.yml | 33 +++++++++++++++++++++++++++++-
 1 file changed, 32 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/gpu-guard-ci.yml b/.github/workflows/gpu-guard-ci.yml
index 1310348..1b9dae7 100644
--- a/.github/workflows/gpu-guard-ci.yml
+++ b/.github/workflows/gpu-guard-ci.yml
@@ -10,6 +10,7 @@ on:
 
 permissions:
   contents: read
+  checks: write
 
 jobs:
   build:
@@ -36,11 +37,41 @@ jobs:
           sudo apt-get install -y --no-install-recommends zstd pkg-config gh
           sdkmanager 'platform-tools' 'platforms;android-34' 'build-tools;34.0.0' 'cmake;3.22.1' 'ndk;27.3.13750724'
       - name: Build the patched app and guest preloads
+        id: build
         run: |
+          set -o pipefail
           test -f app/src/main/java/com/droiddeck/launcher/gpu/DriverArchivePolicy.java
           test -f tools/linuxfs/overlay/usr/local/bin/droiddeck-mali-check
           test -f tools/linuxfs/overlay/usr/local/bin/droiddeck-gpu-probe
-          bash tools/build_local.sh
+          bash tools/build_local.sh 2>&1 | tee /tmp/droiddeck-build.log
+      # The machine working on this branch cannot download Actions logs, only talk to the API, so
+      # on failure the log is published as a check run where it can be read back.
+      - name: Publish the build log
+        if: always() && steps.build.outcome == 'failure'
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          python3 - "$GITHUB_RUN_ID" <<'PY' > /tmp/checkrun.json
+          import json, sys
+          run_id = sys.argv[1]
+          try:
+              log = open('/tmp/droiddeck-build.log', encoding='utf-8', errors='replace').read()
+          except OSError:
+              log = '(no build log)'
+          lines = log.splitlines()
+          keep = [l for l in lines if ('error:' in l or l.startswith('e: ') or 'FAILURE' in l
+                   or 'What went wrong' in l or 'FAILED' in l)][:250]
+          body = "\n".join(lines[-400:]) + "\n\n--- error lines ---\n" + "\n".join(keep)
+          print(json.dumps({
+              "name": "build log",
+              "head_sha": "${{ github.sha }}",
+              "status": "completed",
+              "conclusion": "neutral",
+              "output": {"title": "Build log, run %s" % run_id,
+                         "summary": body[:65000]},
+          }))
+          PY
+          gh api -X POST "/repos/$GITHUB_REPOSITORY/check-runs" --input /tmp/checkrun.json -q .html_url
       - name: Upload debug APK
         uses: actions/upload-artifact@v4
         with:
-- 
