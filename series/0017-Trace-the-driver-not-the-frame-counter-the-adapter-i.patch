diff --git a/drivers/mali-g615/test/mock_backend.c b/drivers/mali-g615/test/mock_backend.c
new file mode 100644
index 0000000..e8c8d9c
--- /dev/null
+++ b/drivers/mali-g615/test/mock_backend.c
@@ -0,0 +1,200 @@
+/*
+ * A fake PanVK backend, for testing the DroidDeck adapter without a GPU.
+ *
+ * It speaks the ICD side of the contract the adapter expects (vk_icd* entry points), reports a
+ * Mali-G615 MC6, and prints what it was asked so a test can assert what the adapter did to it:
+ * which extensions reached vkCreateDevice, and whether the traced calls arrived at all.
+ *
+ * MOCK_HANG makes vkQueuePresentKHR kill the process from the middle of the call, which is the one
+ * shape the adapter's trace exists to catch.
+ *
+ * Not part of the app or the driver package. Built by run_adapter_tests.sh.
+ */
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan_core.h>
+#include <vulkan/vk_icd.h>
+
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static void die_in_call(void) {
+    if (getenv("MOCK_HANG")) {
+        fflush(stdout);
+        fflush(stderr);
+        kill(getpid(), SIGKILL);
+    }
+}
+
+static VKAPI_ATTR void VKAPI_CALL mb_get_physical_device_properties(
+    VkPhysicalDevice device, VkPhysicalDeviceProperties *properties) {
+    (void)device;
+    memset(properties, 0, sizeof(*properties));
+    /* No sType here, unlike VkPhysicalDeviceProperties2: a mock that assumes one agrees with a
+       wrong assumption instead of testing it. tools/test/vulkan_offsets.c is the authority. */
+    properties->apiVersion = VK_MAKE_VERSION(1, 3, 270);
+    properties->driverVersion = 1;
+    properties->vendorID = 0x13b5u;
+    properties->deviceType = VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU;
+    snprintf(properties->deviceName, sizeof(properties->deviceName), "%s", "Mali-G615 MC6");
+}
+
+static VKAPI_ATTR void VKAPI_CALL mb_get_physical_device_properties2(
+    VkPhysicalDevice device, VkPhysicalDeviceProperties2 *properties) {
+    mb_get_physical_device_properties(device, &properties->properties);
+}
+
+/** Two extensions, and deliberately NOT VK_EXT_physical_device_drm: adding it is the adapter's job. */
+static VKAPI_ATTR VkResult VKAPI_CALL mb_enumerate_device_extension_properties(
+    VkPhysicalDevice device, const char *layer_name, uint32_t *count,
+    VkExtensionProperties *properties) {
+    static const char *const names[] = {"VK_KHR_swapchain", "VK_EXT_xlib_surface"};
+    const uint32_t n = sizeof(names) / sizeof(names[0]);
+    (void)device;
+    if (layer_name) { *count = 0; return VK_SUCCESS; }
+    if (!properties) { *count = n; return VK_SUCCESS; }
+    uint32_t copied = *count < n ? *count : n;
+    for (uint32_t i = 0; i < copied; ++i) {
+        snprintf(properties[i].extensionName, VK_MAX_EXTENSION_NAME_SIZE, "%s", names[i]);
+        properties[i].specVersion = 1;
+    }
+    *count = copied;
+    return copied < n ? VK_INCOMPLETE : VK_SUCCESS;
+}
+
+static VKAPI_ATTR VkResult VKAPI_CALL mb_create_device(VkPhysicalDevice physical_device,
+                                                        const VkDeviceCreateInfo *create_info,
+                                                        const VkAllocationCallbacks *allocator,
+                                                        VkDevice *device) {
+    (void)physical_device;
+    (void)allocator;
+    printf("backend: vkCreateDevice enabled %u extensions:",
+           create_info ? create_info->enabledExtensionCount : 0u);
+    for (uint32_t i = 0; create_info && i < create_info->enabledExtensionCount; ++i)
+        printf(" %s", create_info->ppEnabledExtensionNames[i]);
+    printf("\n");
+    *device = (VkDevice)(uintptr_t)0xd1ce;
+    return VK_SUCCESS;
+}
+
+static VKAPI_ATTR VkResult VKAPI_CALL mb_queue_submit(VkQueue queue, uint32_t submit_count,
+                                                      const VkSubmitInfo *submits, VkFence fence) {
+    (void)queue; (void)fence;
+    printf("backend: vkQueueSubmit %u\n", submit_count);
+    (void)submits;
+    return VK_SUCCESS;
+}
+
+static VKAPI_ATTR VkResult VKAPI_CALL mb_queue_submit2(VkQueue queue, uint32_t submit_count,
+                                                        const VkSubmitInfo2 *submits,
+                                                        VkFence fence) {
+    (void)queue; (void)fence; (void)submits;
+    printf("backend: vkQueueSubmit2 %u\n", submit_count);
+    return VK_SUCCESS;
+}
+
+static VKAPI_ATTR VkResult VKAPI_CALL mb_queue_present(VkQueue queue,
+                                                        const VkPresentInfoKHR *present_info) {
+    (void)queue;
+    printf("backend: vkQueuePresentKHR %u swapchains\n",
+           present_info ? present_info->swapchainCount : 0u);
+    die_in_call();
+    return VK_SUCCESS;
+}
+
+static VKAPI_ATTR VkResult VKAPI_CALL mb_acquire_next_image(VkDevice device,
+                                                             VkSwapchainKHR swapchain,
+                                                             uint64_t timeout,
+                                                             VkSemaphore semaphore, VkFence fence,
+                                                             uint32_t *image_index) {
+    (void)device; (void)swapchain; (void)timeout; (void)semaphore; (void)fence;
+    printf("backend: vkAcquireNextImageKHR\n");
+    if (image_index) *image_index = 1;
+    return VK_SUCCESS;
+}
+
+/** VK_TIMEOUT, once: the answer the guard's own probe treats as a hang, so the trace has a result to show. */
+static VKAPI_ATTR VkResult VKAPI_CALL mb_wait_for_fences(VkDevice device, uint32_t count,
+                                                          const VkFence *fences, VkBool32 wait_all,
+                                                          uint64_t timeout) {
+    (void)device; (void)fences; (void)wait_all; (void)timeout;
+    printf("backend: vkWaitForFences %u\n", count);
+    return VK_TIMEOUT;
+}
+
+static VKAPI_ATTR VkResult VKAPI_CALL mb_create_swapchain(VkDevice device,
+                                                           const VkSwapchainCreateInfoKHR *info,
+                                                           const VkAllocationCallbacks *allocator,
+                                                           VkSwapchainKHR *swapchain) {
+    (void)device; (void)allocator;
+    printf("backend: vkCreateSwapchainKHR %ux%u mode=%d\n", info ? info->imageExtent.width : 0u,
+           info ? info->imageExtent.height : 0u, info ? (int)info->presentMode : -1);
+    *swapchain = (VkSwapchainKHR)(uintptr_t)0x5c00;
+    return VK_SUCCESS;
+}
+
+static VKAPI_ATTR VkResult VKAPI_CALL mb_queue_wait_idle(VkQueue queue) {
+    (void)queue;
+    printf("backend: vkQueueWaitIdle\n");
+    return VK_SUCCESS;
+}
+
+static VKAPI_ATTR void VKAPI_CALL mb_destroy_device(VkDevice device,
+                                                    const VkAllocationCallbacks *allocator) {
+    (void)device; (void)allocator;
+}
+
+struct entry { const char *name; void *fn; };
+
+static const struct entry TABLE[] = {
+    {"vkGetPhysicalDeviceProperties", (void *)mb_get_physical_device_properties},
+    {"vkGetPhysicalDeviceProperties2", (void *)mb_get_physical_device_properties2},
+    {"vkEnumerateDeviceExtensionProperties", (void *)mb_enumerate_device_extension_properties},
+    {"vkCreateDevice", (void *)mb_create_device},
+    {"vkDestroyDevice", (void *)mb_destroy_device},
+    {"vkQueueSubmit", (void *)mb_queue_submit},
+    {"vkQueueSubmit2", (void *)mb_queue_submit2},
+    {"vkQueuePresentKHR", (void *)mb_queue_present},
+    {"vkAcquireNextImageKHR", (void *)mb_acquire_next_image},
+    {"vkWaitForFences", (void *)mb_wait_for_fences},
+    {"vkCreateSwapchainKHR", (void *)mb_create_swapchain},
+    {"vkQueueWaitIdle", (void *)mb_queue_wait_idle},
+};
+
+static void *lookup(const char *name) {
+    for (unsigned i = 0; i < sizeof(TABLE) / sizeof(TABLE[0]); ++i)
+        if (!strcmp(TABLE[i].name, name)) return TABLE[i].fn;
+    return NULL;
+}
+
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL vk_icdGetInstanceProcAddr(VkInstance instance,
+                                                                    const char *name) {
+    (void)instance;
+    if (!name) return NULL;
+    return (PFN_vkVoidFunction)lookup(name);
+}
+
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL vk_icdGetPhysicalDeviceProcAddr(VkInstance instance,
+                                                                         const char *name) {
+    return vk_icdGetInstanceProcAddr(instance, name);
+}
+
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL vkGetInstanceProcAddr(VkInstance instance,
+                                                                const char *name) {
+    return vk_icdGetInstanceProcAddr(instance, name);
+}
+
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL vkGetDeviceProcAddr(VkDevice device, const char *name) {
+    (void)device;
+    return (PFN_vkVoidFunction)lookup(name);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL vk_icdNegotiateLoaderICDInterfaceVersion(uint32_t *version) {
+    if (!version) return VK_ERROR_INITIALIZATION_FAILED;
+    if (*version > 7) *version = 7;
+    printf("backend: negotiated ICD interface %u\n", *version);
+    return VK_SUCCESS;
+}
diff --git a/drivers/mali-g615/test/run_adapter_tests.sh b/drivers/mali-g615/test/run_adapter_tests.sh
new file mode 100755
index 0000000..74489f3
--- /dev/null
+++ b/drivers/mali-g615/test/run_adapter_tests.sh
@@ -0,0 +1,129 @@
+#!/usr/bin/env bash
+# Runs the DroidDeck Mali adapter against a fake PanVK backend, on the build machine.
+#
+# The adapter is a pass-through with two additions, and both are things a phone is a bad way to
+# test. It must not change what the backend sees (a pass-through that leaks is how a driver update
+# becomes a game-breaking bug), and its trace must survive a device that dies mid-call - which by
+# definition cannot be observed on the device, because the process and the phone go together.
+#
+# Needs: cc, and Vulkan headers. Set VULKAN_INCLUDE_DIR to a directory holding vulkan/vulkan_core.h
+# and vulkan/vk_icd.h; the CI job clones them from KhronosGroup/Vulkan-Headers.
+#
+# Not part of the app or the driver package; nothing here is installed on the phone.
+set -u
+
+HERE="$(cd "$(dirname "$0")" && pwd)"
+ROOT="$(cd "$HERE/../../.." && pwd)"
+ADAPTER_SRC="$ROOT/drivers/mali-g615/adapter/droiddeck_mali_icd.c"
+WORK="$(mktemp -d)"
+trap 'rm -rf "$WORK"' EXIT
+
+for src in "$ADAPTER_SRC" "$HERE/mock_backend.c" "$HERE/test_adapter.c"; do
+    [ -f "$src" ] || { echo "FAIL: missing $src"; exit 1; }
+done
+command -v cc >/dev/null 2>&1 || { echo "FAIL: no C compiler on this machine"; exit 1; }
+
+VK_INC="${VULKAN_INCLUDE_DIR:-}"
+if [ -z "$VK_INC" ]; then
+    for guess in /usr/include /usr/local/include; do
+        [ -f "$guess/vulkan/vulkan_core.h" ] && [ -f "$guess/vulkan/vk_icd.h" ] && VK_INC="$guess" && break
+    done
+fi
+if [ -z "$VK_INC" ]; then
+    echo "FAIL: no Vulkan headers (set VULKAN_INCLUDE_DIR to a dir with vulkan/vulkan_core.h)"
+    exit 1
+fi
+
+# /dev/null is a char device, which is all the adapter's node lookup needs: it lets the test assert
+# the real major/minor it reports instead of only that it reported something. The shipped build keeps
+# the default /dev/mali0.
+CFLAGS="-O1 -Wall -Wextra -std=gnu11 -fPIC -I$VK_INC -DDD_MALI_NODE=\"/dev/null\""
+FAILED=0
+
+# shellcheck disable=SC2086
+cc $CFLAGS -shared -o "$WORK/libpanvk_backend.so" "$HERE/mock_backend.c" -ldl \
+    || { echo "FAIL: the mock backend did not build"; exit 1; }
+# shellcheck disable=SC2086
+cc $CFLAGS -shared -fvisibility=hidden -o "$WORK/libvulkan_droiddeck_mali.so" "$ADAPTER_SRC" \
+    -ldl -lpthread || { echo "FAIL: the adapter did not build"; exit 1; }
+# shellcheck disable=SC2086
+cc $CFLAGS -o "$WORK/test_adapter" "$HERE/test_adapter.c" -ldl \
+    || { echo "FAIL: the adapter test did not build"; exit 1; }
+
+run_case() {
+    local label="$1"; shift
+    local out status
+    out=$("$@" 2>&1); status=$?
+    if [ "$status" = 0 ]; then
+        echo "  ok   $label"
+    else
+        echo "  FAIL $label (exit $status)"
+        printf '%s\n' "$out" | sed 's/^/       /'
+        FAILED=1
+    fi
+    LAST_OUT="$out"
+}
+
+echo "the adapter, against the fake backend:"
+
+# 1. No DD_ADAPTER_TRACE: what the shipped driver does. Every backend pointer handed straight on,
+# and no file anywhere.
+out=$(cd "$WORK" && ./test_adapter ./libvulkan_droiddeck_mali.so ./libpanvk_backend.so 2>&1); status=$?
+printf '%s\n' "$out" | sed 's/^/  /'
+[ "$status" = 0 ] || FAILED=1
+if ls "$WORK"/gpu-driver-trace.log >/dev/null 2>&1; then
+    echo "  FAIL a session with no DD_ADAPTER_TRACE wrote a trace file"; FAILED=1
+fi
+
+# The backend must have been told about swapchain only: the DRM extension is the adapter's invention
+# and a backend that never advertised it must not receive it.
+if printf '%s\n' "$out" | grep -q 'vkCreateDevice enabled 1 extensions: VK_KHR_swapchain$'; then
+    echo "  ok   the facade extension is added to the list and stripped before the backend sees it"
+else
+    echo "  FAIL the facade extension is added to the list and stripped before the backend sees it"
+    printf '%s\n' "$out" | grep 'vkCreateDevice' | sed 's/^/       /'
+    FAILED=1
+fi
+
+# 2. Tracing on: the calls the session made are in the file, with their results.
+TRACE="$WORK/gpu-driver-trace.log"
+run_case "a traced session passes the same checks" \
+    env DD_ADAPTER_TRACE="$TRACE" DD_TEST_TRACE=1 \
+    "$WORK/test_adapter" "$WORK/libvulkan_droiddeck_mali.so" "$WORK/libpanvk_backend.so"
+missing=0
+for want in '-> vkQueueSubmit' '<- vkQueueSubmit = 0' '-> vkWaitForFences' '<- vkWaitForFences = 2'; do
+    grep -qF -- "$want" "$TRACE" || { echo "  FAIL the trace is missing: $want"; missing=1; }
+done
+if [ "$missing" = 0 ]; then
+    echo "  ok   submit and an unfired fence are both recorded, entry and result"
+fi
+grep -qF -- '<- vkWaitForFences = 2' "$TRACE" && [ "$missing" = 0 ] && \
+    echo "  ok   VK_TIMEOUT is recorded as the number the app will act on"
+if [ "$missing" = 1 ]; then
+    echo "       trace was:"
+    sed 's/^/       /' "$TRACE" 2>/dev/null
+    FAILED=1
+fi
+
+# 3. The reason it exists: the device dies in the middle of a call. The process is killed inside
+# vkQueuePresentKHR, so the trace has to end with that entry and no exit - and it has to have
+# survived the kill, which is what fdatasync per line buys.
+HANG_TRACE="$WORK/hang.log"
+env MOCK_HANG=1 DD_ADAPTER_TRACE="$HANG_TRACE" DD_TEST_TRACE=1 DD_TEST_HANG=1 \
+    "$WORK/test_adapter" "$WORK/libvulkan_droiddeck_mali.so" "$WORK/libpanvk_backend.so" \
+    >/dev/null 2>&1
+last=$(tail -1 "$HANG_TRACE" 2>/dev/null)
+if printf '%s' "$last" | grep -qF -- '-> vkQueuePresentKHR'; then
+    echo "  ok   a process killed mid-present leaves the call it died in as the last line"
+else
+    echo "  FAIL a process killed mid-present leaves the call it died in as the last line"
+    echo "       last line was: ${last:-<no file>}"
+    FAILED=1
+fi
+
+if [ "$FAILED" = 0 ]; then
+    echo "all adapter cases passed"
+else
+    echo "ADAPTER TESTS FAILED"
+fi
+exit "$FAILED"
diff --git a/drivers/mali-g615/test/test_adapter.c b/drivers/mali-g615/test/test_adapter.c
new file mode 100644
index 0000000..d0a1287
--- /dev/null
+++ b/drivers/mali-g615/test/test_adapter.c
@@ -0,0 +1,159 @@
+/*
+ * Drives the DroidDeck adapter the way a Vulkan loader would, against the mock backend beside it.
+ *
+ * This is the only way to know what the adapter does to a session without a phone: it is a
+ * pass-through, so "pass-through" has to be proved, and the two things it adds - the DRM facade and
+ * the trace - have to be seen happening. The adapter under test is built with DD_MALI_NODE pointing
+ * at /dev/null, which is a char device, so the node lookup has a real answer to find.
+ *
+ * Built and run by run_adapter_tests.sh. Not part of the app or the driver package.
+ */
+#define _GNU_SOURCE
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan_core.h>
+
+#include <dlfcn.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+
+static int fails;
+
+#define CHECK(cond, what) do {                                             \
+    if (cond) printf("ok   %s\n", (what));                                  \
+    else { printf("FAIL %s\n", (what)); ++fails; }                          \
+} while (0)
+
+typedef PFN_vkVoidFunction (*gipa_t)(VkInstance, const char *);
+typedef VkResult (*negotiate_t)(uint32_t *);
+typedef VkResult (*enum_ext_t)(VkPhysicalDevice, const char *, uint32_t *, VkExtensionProperties *);
+typedef void (*get_props2_t)(VkPhysicalDevice, VkPhysicalDeviceProperties2 *);
+typedef VkResult (*create_device_t)(VkPhysicalDevice, const VkDeviceCreateInfo *,
+                                    const VkAllocationCallbacks *, VkDevice *);
+typedef VkResult (*queue_submit_t)(VkQueue, uint32_t, const VkSubmitInfo *, VkFence);
+typedef VkResult (*present_t)(VkQueue, const VkPresentInfoKHR *);
+typedef VkResult (*wait_fences_t)(VkDevice, uint32_t, const VkFence *, VkBool32, uint64_t);
+
+int main(int argc, char **argv) {
+    if (argc < 2) {
+        printf("FAIL usage: %s <adapter.so> [backend.so]\n", argv[0]);
+        return 2;
+    }
+    const char *adapter_path = argv[1];
+    const char *backend_path = argc > 2 ? argv[2] : NULL;
+    int want_trace = getenv("DD_TEST_TRACE") != NULL;
+
+    void *adapter = dlopen(adapter_path, RTLD_NOW | RTLD_LOCAL);
+    if (!adapter) {
+        printf("FAIL the adapter did not load: %s\n", dlerror());
+        return 1;
+    }
+    negotiate_t negotiate = (negotiate_t)dlsym(adapter, "vk_icdNegotiateLoaderICDInterfaceVersion");
+    gipa_t gipa = (gipa_t)dlsym(adapter, "vk_icdGetInstanceProcAddr");
+    CHECK(negotiate && gipa, "the adapter exports the ICD entry points a loader needs");
+    if (!negotiate || !gipa) return 1;
+
+    uint32_t version = 8;
+    CHECK(negotiate(&version) == VK_SUCCESS, "interface negotiation succeeds");
+    CHECK(version == 7, "and stops at interface 7, the newest the adapter implements");
+
+    /* The instance is a token here: the mock ignores it, and passing one is what a loader does. */
+    VkInstance instance = (VkInstance)(uintptr_t)0x1111;
+    VkPhysicalDevice physical = (VkPhysicalDevice)(uintptr_t)0x2222;
+
+    enum_ext_t enum_ext = (enum_ext_t)gipa(instance, "vkEnumerateDeviceExtensionProperties");
+    get_props2_t get_props2 = (get_props2_t)gipa(instance, "vkGetPhysicalDeviceProperties2");
+    CHECK(enum_ext && get_props2, "device-level queries are reachable through the adapter");
+    if (!enum_ext || !get_props2) return 1;
+
+    uint32_t count = 0;
+    CHECK(enum_ext(physical, NULL, &count, NULL) == VK_SUCCESS, "the extension count comes back");
+    CHECK(count == 3, "the two the backend has, plus VK_EXT_physical_device_drm the adapter adds");
+    VkExtensionProperties listed[8];
+    memset(listed, 0, sizeof(listed));
+    uint32_t capacity = count;
+    enum_ext(physical, NULL, &capacity, listed);
+    int drm_found = 0;
+    for (uint32_t i = 0; i < capacity; ++i)
+        if (!strcmp(listed[i].extensionName, VK_EXT_PHYSICAL_DEVICE_DRM_EXTENSION_NAME)) ++drm_found;
+    CHECK(drm_found == 1, "and it is named exactly once");
+
+    /* The DRM node identity gamescope reads. */
+    VkPhysicalDeviceDrmPropertiesEXT drm;
+    memset(&drm, 0, sizeof(drm));
+    drm.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRM_PROPERTIES_EXT;
+    VkPhysicalDeviceProperties2 props;
+    memset(&props, 0, sizeof(props));
+    props.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2;
+    props.pNext = &drm;
+    get_props2(physical, &props);
+    CHECK(!strcmp(props.properties.deviceName, "Mali-G615 MC6"),
+          "the backend's own properties arrive untouched");
+    struct stat node;
+    int node_ok = stat(DD_MALI_NODE, &node) == 0 && S_ISCHR(node.st_mode);
+    CHECK(node_ok, "the render node this build was told to look for is there");
+    if (node_ok) {
+        CHECK(drm.hasPrimary == VK_TRUE && drm.hasRender == VK_TRUE,
+              "the adapter claims primary and render for it");
+        CHECK(drm.primaryMajor == (int64_t)major(node.st_rdev) &&
+              drm.primaryMinor == (int64_t)minor(node.st_rdev),
+              "and the major/minor it reports are the node's real ones");
+    }
+
+    /* The adapter must not let an extension it invented reach a backend that never advertised it. */
+    create_device_t create_device = (create_device_t)gipa(instance, "vkCreateDevice");
+    CHECK(create_device != NULL, "vkCreateDevice is reachable");
+    if (create_device) {
+        const char *wanted[] = {VK_EXT_PHYSICAL_DEVICE_DRM_EXTENSION_NAME, "VK_KHR_swapchain"};
+        VkDeviceCreateInfo info;
+        memset(&info, 0, sizeof(info));
+        info.sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO;
+        info.enabledExtensionCount = 2;
+        info.ppEnabledExtensionNames = wanted;
+        VkDevice device = NULL;
+        CHECK(create_device(physical, &info, NULL, &device) == VK_SUCCESS,
+              "vkCreateDevice succeeds with the facade extension requested");
+        printf("note: the backend printed the extensions it received\n");
+    }
+
+    /* Tracing: the calls in the trace must be the calls that reach the GPU. */
+    queue_submit_t submit = (queue_submit_t)gipa(instance, "vkQueueSubmit");
+    present_t present = (present_t)gipa(instance, "vkQueuePresentKHR");
+    wait_fences_t wait_fences = (wait_fences_t)gipa(instance, "vkWaitForFences");
+    CHECK(submit && present && wait_fences, "submit, present and fence waits resolve");
+    if (submit && present && wait_fences) {
+        CHECK(submit((VkQueue)(uintptr_t)0x4444, 0, NULL, (VkFence)(uintptr_t)0x7777) == VK_SUCCESS,
+              "a submit through the adapter reaches the backend");
+        VkSwapchainKHR swapchain = (VkSwapchainKHR)(uintptr_t)0x5c00;
+        VkPresentInfoKHR present_info;
+        memset(&present_info, 0, sizeof(present_info));
+        present_info.sType = VK_STRUCTURE_TYPE_PRESENT_INFO_KHR;
+        present_info.swapchainCount = 1;
+        present_info.pSwapchains = &swapchain;
+        /* Always called. With MOCK_HANG the process dies inside it and this assertion never
+           happens - that is the case being tested, and the trace file is what gets read after. */
+        CHECK(present((VkQueue)(uintptr_t)0x4444, &present_info) == VK_SUCCESS,
+              "a present through the adapter reaches the backend");
+        /* The backend answers VK_TIMEOUT once, on purpose: an unfired fence has to be traceable too. */
+        VkFence fence = (VkFence)(uintptr_t)0x7777;
+        CHECK(wait_fences((VkDevice)(uintptr_t)0xd1ce, 1, &fence, VK_TRUE, 0) == VK_TIMEOUT,
+              "a fence that does not signal comes back as the timeout it is");
+
+        if (backend_path) {
+            void *bare = dlopen(backend_path, RTLD_NOW | RTLD_LOCAL);
+            gipa_t bare_gipa = bare ? (gipa_t)dlsym(bare, "vk_icdGetInstanceProcAddr") : NULL;
+            void *direct = bare_gipa ? (void *)bare_gipa(NULL, "vkQueueSubmit") : NULL;
+            char message[256];
+            snprintf(message, sizeof(message),
+                     "the adapter %s the backend's own pointer for vkQueueSubmit",
+                     want_trace ? "interposes itself in front of" : "hands on untouched:");
+            CHECK(direct && (want_trace ? direct != (void *)submit : direct == (void *)submit),
+                  message);
+        }
+    }
+
+    return fails ? 1 : 0;
+}
