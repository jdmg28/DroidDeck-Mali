+        "vkCreateInstance",
+        [ctypes.c_void_p, ctypes.c_void_p, ctypes.POINTER(ctypes.c_uint64)],
+    )
+    vk_destroy_instance = instance_fn(
+        "vkDestroyInstance", [ctypes.c_uint64, ctypes.c_void_p], ctypes.c_void_p
+    )
+    vk_enumerate_physical_devices = instance_fn(
+        "vkEnumeratePhysicalDevices",
+        [ctypes.c_uint64, ctypes.POINTER(ctypes.c_uint32), ctypes.POINTER(ctypes.c_uint64)],
+    )
+    vk_get_physical_device_properties = instance_fn(
+        "vkGetPhysicalDeviceProperties",
+        [ctypes.c_uint64, ctypes.POINTER(VkPhysicalDeviceProperties)],
+        ctypes.c_void_p,
+    )
+    vk_get_physical_device_memory_properties = instance_fn(
+        "vkGetPhysicalDeviceMemoryProperties",
+        [ctypes.c_uint64, ctypes.POINTER(VkPhysicalDeviceMemoryProperties)],
+        ctypes.c_void_p,
+    )
+    vk_get_physical_device_queue_family_properties = instance_fn(
+        "vkGetPhysicalDeviceQueueFamilyProperties",
+        [ctypes.c_uint64, ctypes.POINTER(ctypes.c_uint32), ctypes.POINTER(VkQueueFamilyProperties)],
+        ctypes.c_void_p,
+    )
+    vk_create_device = instance_fn(
+        "vkCreateDevice",
+        [
+            ctypes.c_uint64,
+            ctypes.c_void_p,
+            ctypes.c_void_p,
+            ctypes.POINTER(ctypes.c_uint64),
+        ],
+    )
+    vk_get_device_proc_addr = instance_fn(
+        "vkGetDeviceProcAddr",
+        [ctypes.c_uint64, ctypes.c_char_p],
+        ctypes.c_void_p,
+    )
+
