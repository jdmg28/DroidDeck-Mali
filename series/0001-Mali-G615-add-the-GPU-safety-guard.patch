+++ b/tools/linuxfs/overlay/usr/local/bin/droiddeck-gpu-probe
@@ -0,0 +1,705 @@
+#!/usr/bin/env bash
+# SPDX-License-Identifier: GPL-3.0-only
+#
+# A bounded GPU smoke test, run inside DroidDeck's Linux guest before gamescope and Steam start.
+# Read-only and unprivileged: no su, no chmod, no SELinux or /vendor changes, nothing written
+# outside the session folder.
+#
+# Why it exists. On the Mali-G615 this integration targets, a Steam session ended in a kernel
+# panic inside mali_kbase (CS_FATAL / CS_BUS_FAULT -> FENCE_SIGNAL timeout(3000 ms) ->
+# "Unexpected kernel BRK exception at EL1" in kbasep_csf_sync_kcpu_dump_locked). An APK can
+# neither repair that module nor read the kernel log that would name the trigger. What it can do
+# is refuse to hand the GPU a 700 MB client before it has proven it can finish one 4 KB job.
+#
+# Three stages, each with its own timeout, each failure labelled:
+#   1. enumeration  - the ICD loads and the device names itself (Mali-G615).
+#   2. submit       - one vkCmdFillBuffer is queued and its fence waited for. A fence that never
+#                     signals is the exact shape of the fault that took the phone down, and it is
+#                     the only outcome this script reports as a hard failure.
+#   3. readback     - the bytes come back as they were written, so a driver that signals a fence
+#                     without having done the work cannot pass.
+#
+# Stage 2 and 3 are skipped, not failed, when they cannot be built (no python3, no matching queue
+# family, a struct the ICD refuses). A test that cannot be run is not evidence against the GPU, and
+# reporting it as one would lock the user out of their own phone over a bug in this script.
+#
+# Output, one per line, on stdout:
+#   DD_GPU_PROBE_OK: ...
+#   DD_GPU_PROBE_FAILED: ...           exit 78
+#   DD_GPU_PROBE_SUBMIT_TIMEOUT: ...   exit 78   (the GPU did not finish; do not start Steam)
+#   DD_GPU_PROBE_SKIPPED: ...          exit 0    (a stage could not be run)
+#
+set -u
+
+mode=${1:-safe}
+# The wall clock the app enforces as well; kept shorter here so the kernel, not this script, is
+# never the thing left holding a wedged queue.
+enum_seconds=${DD_GPU_PROBE_ENUM_SECONDS:-25}
+submit_seconds=${DD_GPU_PROBE_SUBMIT_SECONDS:-20}
+# Fence wait, inside python. A GPU that is working answers this in well under a millisecond; the
+# kernel's own fence timeout on this device is 3000 ms, so anything past ~2 s is already the fault
+# we are looking for and there is no point waiting longer to say so.
+fence_ns=${DD_GPU_PROBE_FENCE_NS:-2000000000}
+
+echo "== droiddeck-gpu-probe $(date -u +%H:%M:%S): profile=$mode enum=${enum_seconds}s submit=${submit_seconds}s"
+
+# ── Stage 0: what the session would hand the GPU ──────────────────────────────────────────────
+icd=${BL_VK_DRIVER:-${VK_DRIVER_FILES:-${VK_ICD_FILENAMES:-}}}
+if [ -z "$icd" ]; then
+    echo "DD_GPU_PROBE_FAILED: no Vulkan driver was selected for this session"
+    exit 78
+fi
+if [ ! -r "$icd" ]; then
+    echo "DD_GPU_PROBE_FAILED: the selected driver manifest is not readable: $icd"
+    exit 78
+fi
+echo "== driver manifest: $icd"
+if [ ! -c /dev/mali0 ]; then
+    echo "DD_GPU_PROBE_FAILED: /dev/mali0 is absent or is not a character device in the guest"
+    exit 78
+fi
+if command -v ls >/dev/null 2>&1; then
+    echo "== /dev/mali0: $(ls -l /dev/mali0 2>/dev/null | awk '{print $1, $5, $6}' || echo 'not statable')"
+fi
+
+# ── Stage 1: enumeration ──────────────────────────────────────────────────────────────────────
+if ! command -v vulkaninfo >/dev/null 2>&1; then
+    echo "DD_GPU_PROBE_SKIPPED: vulkaninfo is not installed; the device was not enumerated"
+    vulkan_summary=""
+else
+    if command -v timeout >/dev/null 2>&1; then
+        vulkan_summary=$(VK_LOADER_DEBUG=error timeout "${enum_seconds}s" vulkaninfo --summary 2>&1)
+        vulkan_status=$?
+    else
+        echo "DD_GPU_PROBE_SKIPPED: timeout is not installed; not running an unbounded GPU probe"
+        vulkan_summary=""
+        vulkan_status=0
+    fi
+    printf '%s\n' "$vulkan_summary" | sed 's/^/== vulkaninfo: /'
+    if [ "$vulkan_status" = 124 ] || [ "$vulkan_status" = 137 ]; then
+        # 124 = timed out, 137 = killed. Either way the GPU did not answer an enumeration in time,
+        # which on this device is the same silence that preceded the panic.
+        echo "DD_GPU_PROBE_SUBMIT_TIMEOUT: enumerating the device did not finish in ${enum_seconds}s (exit $vulkan_status)"
+        exit 78
+    fi
+    if [ "$vulkan_status" != 0 ]; then
+        echo "DD_GPU_PROBE_FAILED: vulkaninfo exited $vulkan_status; the driver did not enumerate"
+        exit 78
+    fi
+    if [ -n "$vulkan_summary" ] && ! printf '%s\n' "$vulkan_summary" | grep -Eq 'Mali-G615([[:space:]]|\(|$)'; then
+        echo "DD_GPU_PROBE_FAILED: the selected driver did not report a Mali-G615 ($(printf '%s\n' "$vulkan_summary" | grep -m1 -E 'deviceName|device Name' || echo 'no device name'))"
+        exit 78
+    fi
+fi
+
+# ── Stages 2 and 3: one job, and its answer ───────────────────────────────────────────────────
+if ! command -v python3 >/dev/null 2>&1; then
+    echo "DD_GPU_PROBE_OK: device enumerated; the submit stage was skipped (no python3)"
+    exit 0
+fi
+
+submit_seconds_int=${submit_seconds%s}
+if command -v timeout >/dev/null 2>&1; then
+    DD_GPU_PROBE_SUBMIT=1 DD_GPU_PROBE_FENCE_NS="$fence_ns" \
+        timeout "${submit_seconds_int}s" python3 - "$icd" <<'PY'
+import ctypes
+import json
+import os
+import pathlib
+import sys
+
+# A minimal Vulkan submit, straight against the session's ICD - no loader, so there is nothing
+# between this script and the driver the session itself would use. The whole point is the fence:
+# if the GPU completes the work it is signalled in microseconds, and if it does not, that is the
+# failure mode this probe exists to catch before Steam is asked to try the same thing.
+
+VK_SUCCESS = 0
+VK_TIMEOUT = 2
+VK_NULL = None
+
+ST_APPLICATION_INFO = 0
+ST_INSTANCE_CREATE_INFO = 1
+ST_DEVICE_QUEUE_CREATE_INFO = 2
+ST_DEVICE_CREATE_INFO = 3
+ST_SUBMIT_INFO = 4
+ST_MEMORY_ALLOCATE_INFO = 5
+ST_FENCE_CREATE_INFO = 8
+ST_BUFFER_CREATE_INFO = 12
+ST_COMMAND_POOL_CREATE_INFO = 39
+ST_COMMAND_BUFFER_ALLOCATE_INFO = 40
+ST_COMMAND_BUFFER_BEGIN_INFO = 42
+
+QUEUE_GRAPHICS = 0x1
+QUEUE_COMPUTE = 0x2
+QUEUE_TRANSFER = 0x4
+
+BUFFER_USAGE_TRANSFER_DST = 0x00000002
+MEMORY_HOST_VISIBLE = 0x00000002
+MEMORY_HOST_COHERENT = 0x00000004
+COMMAND_BUFFER_LEVEL_PRIMARY = 0
+COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT = 0x00000001
+
+SIZE = 4096
+PATTERN = 0x5AA5A55A
+
+
+class Fail(Exception):
+    """Something this script needs is missing: a skip, never a verdict on the GPU."""
+
+
+class VkApplicationInfo(ctypes.Structure):
+    _fields_ = [
+        ("sType", ctypes.c_uint32),
+        ("pNext", ctypes.c_void_p),
+        ("pApplicationName", ctypes.c_char_p),
+        ("applicationVersion", ctypes.c_uint32),
+        ("pEngineName", ctypes.c_char_p),
+        ("engineVersion", ctypes.c_uint32),
+        ("apiVersion", ctypes.c_uint32),
+    ]
+
+
+class VkInstanceCreateInfo(ctypes.Structure):
+    _fields_ = [
+        ("sType", ctypes.c_uint32),
+        ("pNext", ctypes.c_void_p),
+        ("flags", ctypes.c_uint32),
+        ("pApplicationInfo", ctypes.c_void_p),
+        ("enabledLayerCount", ctypes.c_uint32),
+        ("ppEnabledLayerNames", ctypes.c_void_p),
+        ("enabledExtensionCount", ctypes.c_uint32),
+        ("ppEnabledExtensionNames", ctypes.c_void_p),
+    ]
+
+
+class VkDeviceQueueCreateInfo(ctypes.Structure):
