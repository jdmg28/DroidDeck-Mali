+        check(vk_create_buffer(device_value, ctypes.byref(buffer_info), None, ctypes.byref(buffer)), "vkCreateBuffer")
+        buffer_value = buffer.value
+
+        requirements = VkMemoryRequirements()
+        vk_get_buffer_memory_requirements(device_value, buffer_value, ctypes.byref(requirements))
+
+        memory_type = -1
+        for index in range(memory_properties.memoryTypeCount):
+            if requirements.memoryTypeBits & (1 << index):
+                flags = memory_properties.memoryTypes[index].propertyFlags
+                if flags & MEMORY_HOST_VISIBLE and flags & MEMORY_HOST_COHERENT:
+                    memory_type = index
+                    break
+        if memory_type < 0:
+            raise Fail("no host-visible, host-coherent memory type for the probe's buffer")
+
+        allocate_info = VkMemoryAllocateInfo(
+            sType=ST_MEMORY_ALLOCATE_INFO, allocationSize=requirements.size, memoryTypeIndex=memory_type
+        )
+        memory = ctypes.c_uint64(0)
+        check(vk_allocate_memory(device_value, ctypes.byref(allocate_info), None, ctypes.byref(memory)), "vkAllocateMemory")
+        memory_value = memory.value
+        check(vk_bind_buffer_memory(device_value, buffer_value, memory_value, 0), "vkBindBufferMemory")
+
+        mapped = ctypes.c_void_p(0)
+        check(vk_map_memory(device_value, memory_value, 0, SIZE, 0, ctypes.byref(mapped)), "vkMapMemory")
+        try:
+            ctypes.memset(mapped, 0, SIZE)
+        except Exception:
+            pass
+
+        pool_info = VkCommandPoolCreateInfo(sType=ST_COMMAND_POOL_CREATE_INFO, queueFamilyIndex=family_index)
+        pool = ctypes.c_uint64(0)
+        check(vk_create_command_pool(device_value, ctypes.byref(pool_info), None, ctypes.byref(pool)), "vkCreateCommandPool")
+        pool_value = pool.value
+
+        allocate_buffers = VkCommandBufferAllocateInfo(
+            sType=ST_COMMAND_BUFFER_ALLOCATE_INFO,
+            commandPool=pool_value,
+            level=COMMAND_BUFFER_LEVEL_PRIMARY,
+            commandBufferCount=1,
+        )
+        command_buffer = ctypes.c_uint64(0)
+        check(vk_allocate_command_buffers(device_value, ctypes.byref(allocate_buffers), ctypes.byref(command_buffer)), "vkAllocateCommandBuffers")
+        command_buffer_value = command_buffer.value
+
+        begin_info = VkCommandBufferBeginInfo(sType=ST_COMMAND_BUFFER_BEGIN_INFO, flags=COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT)
+        check(vk_begin_command_buffer(command_buffer_value, ctypes.byref(begin_info)), "vkBeginCommandBuffer")
+        vk_cmd_fill_buffer(command_buffer_value, buffer_value, 0, SIZE, PATTERN)
+        check(vk_end_command_buffer(command_buffer_value), "vkEndCommandBuffer")
+
+        fence_info = VkFenceCreateInfo(sType=ST_FENCE_CREATE_INFO)
+        fence = ctypes.c_uint64(0)
+        check(vk_create_fence(device_value, ctypes.byref(fence_info), None, ctypes.byref(fence)), "vkCreateFence")
+        fence_value = fence.value
+
+        submit_info = VkSubmitInfo(sType=ST_SUBMIT_INFO, commandBufferCount=1)
+        submit_info.pCommandBuffers = ctypes.cast(ctypes.byref(command_buffer), ctypes.c_void_p)
+        check(vk_queue_submit(queue.value, 1, ctypes.byref(submit_info), fence_value), "vkQueueSubmit")
+        sys.stdout.write("== submitted one %d-byte fill; waiting for its fence\n" % SIZE)
+        sys.stdout.flush()
+
+        # ── From here on, the GPU's answer is the only thing being measured. ──────────────────
+        fence_array = (ctypes.c_uint64 * 1)(fence_value)
+        status = vk_wait_for_fences(device_value, 1, fence_array, 1, int(os.environ.get("DD_GPU_PROBE_FENCE_NS", "2000000000")))
+        if status == VK_TIMEOUT:
+            # Not a skip and not a script fault: work was queued and the GPU did not finish it.
+            print("DD_GPU_PROBE_SUBMIT_TIMEOUT: a queued %d-byte fill did not complete within the fence wait" % SIZE)
+            sys.exit(78)
+        check(status, "vkWaitForFences")
+
+        words = ctypes.cast(mapped, ctypes.POINTER(ctypes.c_uint32))
+        bad = -1
+        for index in range(SIZE // 4):
+            if words[index] != PATTERN:
+                bad = index
+                break
+        if bad >= 0:
+            print("DD_GPU_PROBE_FAILED: the fence was signalled but the buffer reads 0x%08x at word %d (expected 0x%08x)"
+                  % (words[bad], bad, PATTERN))
+            sys.exit(78)
+
+        print("== read back %d bytes, all 0x%08x" % (SIZE, PATTERN))
+
+        vk_destroy_fence(device_value, fence_value, None)
+        vk_free_command_buffers(device_value, pool_value, 1, ctypes.cast(ctypes.byref(command_buffer), ctypes.c_void_p))
+        vk_destroy_command_pool(device_value, pool_value, None)
+        vk_unmap_memory(device_value, memory_value)
+        vk_destroy_buffer(device_value, buffer_value, None)
+        vk_free_memory(device_value, memory_value, None)
+        vk_destroy_device(device_value, None)
