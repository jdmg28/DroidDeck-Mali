+        sType=ST_APPLICATION_INFO,
+        pNext=None,
+        pApplicationName=b"droiddeck-gpu-probe",
+        applicationVersion=1,
+        pEngineName=b"droiddeck",
+        engineVersion=1,
+        apiVersion=(1 << 22) | (1 << 12),  # Vulkan 1.1
+    )
