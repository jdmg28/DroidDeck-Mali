@@ -0,0 +1,173 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+package com.droiddeck.launcher.gpu.guard
+
+import android.content.Context
+import com.droiddeck.launcher.core.DeviceSupport
+
+/**
+ * The GPU guard's own settings, in their own preferences file.
+ *
+ * Defaults are chosen for the device this build exists for: on a Mali-G615 every switch below is
+ * on, because that is the device where a Steam session ended in a kernel panic. On an Adreno the
+ * guard is off until someone turns it on - it costs a little and protects against something that
+ * has not been seen there.
+ *
+ * The history fields ([fatalBootCount], [cleanSessionsSinceFatal], [lockEngaged]) are not
+ * preferences in the usual sense: they are the latch's memory, and they are what stops a phone
+ * from walking back into the same crash over and over.
+ */
+object GpuSafetyPrefs {
+    private const val FILE = "gpu_safety"
+
+    /** No change to a session; the guard only watches and reports. */
+    const val PROFILE_OFF = "off"
+
+    /** The everyday setting for an experimental GPU: smaller output, a frame cap, nothing extra. */
+    const val PROFILE_SAFE = "safe"
+
+    /** What runs after the device has crashed once: the smallest session that still starts Steam. */
+    const val PROFILE_STRICT = "strict"
+
+    /** How many clean session ends in a row relax a lock the guard engaged by itself. */
+    const val CLEAN_RUNS_TO_RELAX = 3
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences(FILE, Context.MODE_PRIVATE)
+
+    /** The guard as a whole. Off, it does not watch, does not probe and does not block anything. */
+    fun guardEnabled(context: Context): Boolean =
+        prefs(context).getBoolean("guardEnabled", DeviceSupport.mali())
+
+    fun setGuardEnabled(context: Context, on: Boolean) =
+        prefs(context).edit().putBoolean("guardEnabled", on).apply()
+
+    /** Whether a boot recorded as a crash blocks the next launch until the user re-arms. */
+    fun lockAfterFatalBoot(context: Context): Boolean =
+        prefs(context).getBoolean("lockAfterFatalBoot", true)
+
+    fun setLockAfterFatalBoot(context: Context, on: Boolean) =
+        prefs(context).edit().putBoolean("lockAfterFatalBoot", on).apply()
+
+    /** A bounded GPU smoke test inside the runtime before gamescope and Steam are started. */
+    fun preflightProbe(context: Context): Boolean =
+        prefs(context).getBoolean("preflightProbe", true)
+
+    fun setPreflightProbe(context: Context, on: Boolean) =
+        prefs(context).edit().putBoolean("preflightProbe", on).apply()
+
+    /** The live watchdog while a session runs: frames, wedged processes, temperature. */
+    fun liveWatchdog(context: Context): Boolean =
+        prefs(context).getBoolean("liveWatchdog", true)
+
+    fun setLiveWatchdog(context: Context, on: Boolean) =
+        prefs(context).edit().putBoolean("liveWatchdog", on).apply()
+
+    /** How long the session may go without presenting a frame before the guard acts, in ms. */
+    fun stallBudgetMs(context: Context): Int =
+        prefs(context).getInt("stallBudgetMs", 5000).coerceIn(1000, 60_000)
+
+    fun setStallBudgetMs(context: Context, ms: Int) =
+        prefs(context).edit().putInt("stallBudgetMs", ms.coerceIn(1000, 60_000)).apply()
+
+    /**
+     * The battery temperature the guard acts on, in °C; 0 turns the thermal watch off. 44 is where
+     * a phone in a hand is uncomfortably hot and well inside the skin-temperature limits the
+     * platform itself enforces - the guard is meant to act before those, not after them.
+     */
+    fun thermalCeilingC(context: Context): Int =
+        prefs(context).getInt("thermalCeilingC", 44).coerceIn(0, 60)
+
+    fun setThermalCeilingC(context: Context, celsius: Int) =
+        prefs(context).edit().putInt("thermalCeilingC", celsius.coerceIn(0, 60)).apply()
+
+    /** The profile the user chose. What actually runs is [GpuGuard.profile], which the lock raises. */
+    fun chosenProfile(context: Context): String =
+        prefs(context).getString("profile", if (DeviceSupport.mali()) PROFILE_SAFE else PROFILE_OFF)
+            ?: PROFILE_OFF
+
+    fun setChosenProfile(context: Context, id: String) =
+        prefs(context).edit().putString("profile", id).apply()
+
+    /** Draw the Steam client's interface on the CPU (llvmpipe) instead of through the Mali Vulkan
+     *  stack. Slow and ugly, and the reason it exists is diagnosis: if the fault goes away with it,
+     *  it is in the Vulkan path and not in the client. */
+    fun softwareUi(context: Context): Boolean = prefs(context).getBoolean("softwareUi", false)
+
+    fun setSoftwareUi(context: Context, on: Boolean) =
+        prefs(context).edit().putBoolean("softwareUi", on).apply()
+
+    // ── The latch's memory ───────────────────────────────────────────────────────────────────
+
+    /** Boots in a row (or since the start) that Android recorded as a crash. */
+    fun fatalBootCount(context: Context): Int = prefs(context).getInt("fatalBootCount", 0)
+
+    fun setFatalBootCount(context: Context, count: Int) =
+        prefs(context).edit().putInt("fatalBootCount", count.coerceAtLeast(0)).apply()
+
+    fun lastFatalBootAt(context: Context): Long = prefs(context).getLong("lastFatalBootAt", 0L)
+
+    fun setLastFatalBootAt(context: Context, at: Long) =
+        prefs(context).edit().putLong("lastFatalBootAt", at).apply()
+
+    fun lastFatalBootReason(context: Context): String =
+        prefs(context).getString("lastFatalBootReason", "") ?: ""
+
+    fun setLastFatalBootReason(context: Context, reason: String) =
+        prefs(context).edit().putString("lastFatalBootReason", reason).apply()
+
+    /** Session ends the guard forced, ever. Evidence for "this is not a one-off". */
+    fun guardStops(context: Context): Int = prefs(context).getInt("guardStops", 0)
+
+    private fun setGuardStops(context: Context, count: Int) =
+        prefs(context).edit().putInt("guardStops", count.coerceAtLeast(0)).apply()
+
+    fun countGuardStop(context: Context) = setGuardStops(context, guardStops(context) + 1)
+
+    /** Sessions that ended on their own (a clean quit) since the last crash. */
+    fun cleanSessionsSinceFatal(context: Context): Int =
+        prefs(context).getInt("cleanSessionsSinceFatal", 0)
+
+    fun setCleanSessionsSinceFatal(context: Context, count: Int) =
+        prefs(context).edit().putInt("cleanSessionsSinceFatal", count.coerceAtLeast(0)).apply()
+
+    /** The lock: a launch is refused until the user re-arms, or until [CLEAN_RUNS_TO_RELAX] clean runs. */
+    fun lockEngaged(context: Context): Boolean = prefs(context).getBoolean("lockEngaged", false)
+
+    fun setLockEngaged(context: Context, on: Boolean) =
+        prefs(context).edit().putBoolean("lockEngaged", on).apply()
+
+    /** The last pre-flight probe, for the page and the device report. */
+    fun lastProbeAt(context: Context): Long = prefs(context).getLong("lastProbeAt", 0L)
+
+    fun lastProbeOk(context: Context): Boolean = prefs(context).getBoolean("lastProbeOk", false)
+
+    fun lastProbeSummary(context: Context): String =
+        prefs(context).getString("lastProbeSummary", "") ?: ""
+
+    fun setLastProbe(context: Context, ok: Boolean, summary: String) =
+        prefs(context).edit()
+            .putLong("lastProbeAt", System.currentTimeMillis())
+            .putBoolean("lastProbeOk", ok)
+            .putString("lastProbeSummary", summary.take(2000))
+            .apply()
+
+    /**
+     * `elapsedRealtime()` at the app's last start. It only ever rises within a boot, so a value
+     * behind the one on file means the phone has rebooted since - which is how the guard counts one
+     * crash once instead of once per app start. Kept out of [reset]: it is not evidence, it is a
+     * clock, and clearing it would make the next start look like a new boot.
+     */
+    fun lastSeenUptime(context: Context): Long = prefs(context).getLong("lastSeenUptime", -1L)
+
+    fun setLastSeenUptime(context: Context, uptimeMillis: Long) =
+        prefs(context).edit().putLong("lastSeenUptime", uptimeMillis).apply()
+
+    /** Clears the crash history and the lock. The counters are evidence; this throws it away. */
+    fun reset(context: Context) = prefs(context).edit()
+        .putInt("fatalBootCount", 0)
+        .putLong("lastFatalBootAt", 0L)
+        .putString("lastFatalBootReason", "")
+        .putInt("cleanSessionsSinceFatal", 0)
+        .putBoolean("lockEngaged", false)
+        .apply()
+}
diff --git a/app/src/main/java/com/droiddeck/launcher/gpu/guard/GpuWatchdog.kt b/app/src/main/java/com/droiddeck/launcher/gpu/guard/GpuWatchdog.kt
new file mode 100644
index 0000000..1a5b46e
--- /dev/null
+++ b/app/src/main/java/com/droiddeck/launcher/gpu/guard/GpuWatchdog.kt
@@ -0,0 +1,297 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+package com.droiddeck.launcher.gpu.guard
+
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.os.BatteryManager
+import android.os.Build
+import android.os.PowerManager
+import android.os.SystemClock
+import com.droiddeck.launcher.session.SessionState
+import com.droiddeck.launcher.wayland.WaylandCompositor
+import java.io.File
+
+/**
+ * Watches a running session for the two things that come before a GPU that stops answering.
+ *
+ * An APK cannot make the Mali kernel module more robust. What it can do is notice that the session
+ * has stopped moving and take it down itself, in the app's own time, rather than leaving the
+ * kernel to discover the same thing three seconds later on a path that ends in a panic.
+ *
+ * Two independent signals, because either alone would cry wolf:
+ *
+ * - **Frames.** The compositor records the interval between presented frames
+ *   ([WaylandCompositor.recentFrameIntervalMs]). gamescope presents continuously, so a gap of
+ *   many seconds is not "a heavy scene", it is a session that has stopped.
+ * - **Wedged processes.** A GPU that has stopped completing jobs leaves the threads waiting on it
+ *   in uninterruptible sleep (`D` in /proc). A momentary `D` is normal I/O; several of our own
+ *   processes sitting in it across consecutive samples is a fence that is never going to be
+ *   signalled.
+ *
+ * Plus temperature, which is not a fault but is the one cause the app can do something about
+ * before it becomes one.
+ *
+ * It acts once. A guard that keeps escalating after the session is already coming down would be
+ * noise on top of the teardown.
+ */
+class GpuWatchdog(
+    private val context: Context,
+    private val budgetMs: Long,
+    private val thermalCeilingC: Int,
+    private val onAction: (Action, String) -> Unit,
+) {
+    enum class Action { WARN, ABORT }
+
+    private val TAG = "GpuWatchdog"
+    private val lock = Any()
+
+    @Volatile
+    private var running = false
+
+    private var thread: Thread? = null
+
+    /** Samples in a row with no frame: one is a warning, two is a stop. */
+    private var stallSamples = 0
+
+    /** Samples in a row with our processes wedged in uninterruptible sleep. */
+    private var wedgedSamples = 0
+
+    private var thermalTripped = false
+    private var warned = false
+    private var acted = false
+
+    private var lastSampleAt = 0L
+
+    /** The newest readings, for the HUD line and the log. */
+    @Volatile
+    var lastFrameIntervalMs: Long = -1
+        private set
+
+    @Volatile
+    var lastWedged: Int = 0
+        private set
+
+    @Volatile
+    var lastThermalC: Int = Int.MIN_VALUE
+        private set
+
+    private val power by lazy { context.getSystemService(Context.POWER_SERVICE) as? PowerManager }
+
+    fun start() {
+        synchronized(lock) {
+            if (running) return
+            running = true
+            acted = false
+            warned = false
+            stallSamples = 0
+            wedgedSamples = 0
+            thermalTripped = false
+            lastSampleAt = 0L
+        }
+        thread = Thread({
+            GpuGuardLog.log(TAG, "watchdog on: frame budget ${budgetMs}ms, thermal ceiling " +
+                (if (thermalCeilingC > 0) "${thermalCeilingC}C" else "off"))
+            while (true) {
+                synchronized(lock) { if (!running) break }
+                try {
+                    Thread.sleep(SAMPLE_MS)
+                } catch (e: InterruptedException) {
+                    break
+                }
+                synchronized(lock) { if (!running) break }
+                try {
+                    sample()
+                } catch (t: Throwable) {
+                    // A watchdog that dies on an unexpected exception is worse than none: it
+                    // leaves the session running with nothing watching it, silently.
+                    GpuGuardLog.log(TAG, "sample failed: $t")
+                }
+            }
+            GpuGuardLog.log(TAG, "watchdog off")
+        }, "gpu-watchdog").apply { isDaemon = true; start() }
+    }
+
+    fun stop() {
+        synchronized(lock) {
+            if (!running) return
+            running = false
+        }
+        thread?.interrupt()
+        thread = null
+    }
+
+    /** The session is already coming down: stop watching, and stop reporting. */
+    fun standDown() {
+        synchronized(lock) { running = false; acted = true }
+        thread?.interrupt()
+        thread = null
+    }
+
+    private fun sample() {
+        val interactive = power?.isInteractive ?: true
+        val presenting = SessionState.firstFrameSeen && !SessionState.suspended
+
+        // A screen that is off presents nothing and suspends the session's GPU work by design.
+        // Treating that as a stall would stop every session the moment the phone sleeps.
+        if (!interactive) {
+            stallSamples = 0
+            wedgedSamples = 0
+            return
+        }
+
+        val frame = WaylandCompositor.recentFrameIntervalMs()
+        lastFrameIntervalMs = frame
+        val wedged = if (presenting) uninterruptibleCount() else 0
+        lastWedged = wedged
+        val thermal = thermalCelsius()
+        lastThermalC = thermal
+
+        // A periodic reading, so a crash has a run-up recorded and not just a last word.
+        val now = SystemClock.elapsedRealtime()
+        if (lastSampleAt == 0L || now - lastSampleAt >= TRACE_MS) {
+            lastSampleAt = now
+            GpuGuardLog.log(TAG, "sample: frames ${frame}ms, wedged $wedged, " +
+                (if (thermal == Int.MIN_VALUE) "thermal unknown" else "battery ${thermal}C"))
+        }
+
+        if (acted) return
+
+        if (presenting && frame > budgetMs) {
+            stallSamples++
+            if (stallSamples == 1) {
+                GpuGuardLog.log(TAG, "no frame for ${frame}ms (budget ${budgetMs}ms)")
+                warn("no frame for ${frame / 1000}s")
+            } else if (stallSamples >= 2) {
+                act(Action.ABORT, "the session presented no frame for ${frame / 1000}s")
+                return
+            }
+        } else {
+            stallSamples = 0
+        }
+
+        if (presenting && wedged >= WEDGED_COUNT) {
+            wedgedSamples++
+            if (wedgedSamples == WEDGED_SAMPLES) {
+                act(Action.ABORT, "$wedged processes of this app stuck in uninterruptible sleep " +
+                    "for ${(WEDGED_SAMPLES * SAMPLE_MS) / 1000}s - the GPU has stopped completing work")
+                return
+            }
+        } else {
+            wedgedSamples = 0
+        }
+
+        if (thermalCeilingC > 0 && thermal != Int.MIN_VALUE && thermal >= thermalCeilingC) {
+            if (thermalTripped) {
+                act(Action.ABORT, "battery at ${thermal}C, at or above the ${thermalCeilingC}C ceiling")
+                return
+            }
+            thermalTripped = true
+            GpuGuardLog.log(TAG, "battery at ${thermal}C (ceiling ${thermalCeilingC}C)")
+            warn("the device is at ${thermal}C")
+        } else if (thermalCeilingC > 0 && thermal != Int.MIN_VALUE && thermal < thermalCeilingC - HYSTERESIS_C) {
+            thermalTripped = false
+        }
+    }
+
+    private fun warn(message: String) {
+        if (warned) return
+        warned = true
+        onAction(Action.WARN, message)
+    }
+
+    private fun act(action: Action, message: String) {
+        synchronized(lock) {
+            if (acted) return
+            acted = true
+        }
+        GpuGuardLog.log(TAG, "${action.name}: $message")
+        onAction(action, message)
+    }
+
+    /**
+     * How many processes of this app's own uid are in uninterruptible sleep right now. A GPU fence
+     * that will never be signalled parks every thread waiting on it in `D`; ordinary I/O parks one
+     * for a moment. Only processes of our own uid are counted, so a busy phone never trips this.
+     */
+    private fun uninterruptibleCount(): Int {
+        val uid = android.os.Process.myUid()
+        var count = 0
+        val entries = File("/proc").listFiles() ?: return 0
+        for (entry in entries) {
+            val pid = entry.name.toIntOrNull() ?: continue
+            if (pid <= 1) continue
+            val stat = try {
+                File(entry, "stat").readText()
+            } catch (e: Exception) {
+                continue
+            }
+            // "pid (comm) S ppid ...": comm may hold spaces and parentheses, the last ") " ends it.
+            val after = stat.substringAfterLast(") ", "")
+            if (after.isEmpty() || after[0] != 'D') continue
+            if (uidOf(pid) == uid) count++
+        }
+        return count
+    }
+
+    private fun uidOf(pid: Int): Int = try {
+        File("/proc/$pid/status").useLines { lines ->
+            lines.firstOrNull { it.startsWith("Uid:") }
+                ?.substringAfter("Uid:")?.trim()?.split(Regex("\\s+"))?.firstOrNull()?.toIntOrNull() ?: -1
+        }
+    } catch (e: Exception) {
+        -1
+    }
+
+    /**
+     * The battery's temperature in °C. It is the one thermal number an app may read on a stock
+     * phone: the thermal zones under /sys/class/thermal are labelled for the platform, not for us,
+     * and are refused on most devices. Tried first anyway, because where it is readable it is the
+     * temperature that is actually rising.
+     */
+    private fun thermalCelsius(): Int {
+        zoneCelsius()?.let { return it }
+        return try {
+            val intent = context.registerReceiver(null, IntentFilter(Intent.ACTION_BATTERY_CHANGED))
+            val tenths = intent?.getIntExtra(BatteryManager.EXTRA_TEMPERATURE, Int.MIN_VALUE) ?: Int.MIN_VALUE
+            if (tenths == Int.MIN_VALUE) Int.MIN_VALUE else tenths / 10
+        } catch (e: Exception) {
+            Int.MIN_VALUE
+        }
+    }
+
+    private fun zoneCelsius(): Int? {
+        if (Build.VERSION.SDK_INT < 26) return null
+        val zones = File("/sys/class/thermal").listFiles() ?: return null
+        var hottest: Int? = null
+        for (zone in zones) {
+            val raw = try {
+                File(zone, "temp").readText().trim().toLongOrNull()
+            } catch (e: Exception) {
+                null
+            } ?: continue
+            // Some kernels report millidegrees, some degrees; nothing a phone reaches is below 1 °C.
+            val celsius = if (raw > 1000) (raw / 1000).toInt() else raw.toInt()
+            if (celsius in 1..140 && (hottest == null || celsius > hottest)) hottest = celsius
+        }
+        return hottest
+    }
+
+    companion object {
+        /** Two samples a second: fast enough to act inside a kernel's own fence timeout, cheap
+         *  enough to run for hours (one /proc read per process per sample). */
+        const val SAMPLE_MS = 500L
+
+        /** A periodic line in the log, so a crash has a run-up and not just a last word. */
+        const val TRACE_MS = 4000L
+
+        /** Processes in uninterruptible sleep that count as "the GPU has stopped". */
+        const val WEDGED_COUNT = 3
+
+        /** Samples in a row that has to hold: ~1.5 s, so ordinary I/O never trips it. */
+        const val WEDGED_SAMPLES = 3
+
+        /** How far the temperature has to come back before the thermal trip is cleared. */
+        const val HYSTERESIS_C = 3
+    }
+}
diff --git a/app/src/main/java/com/droiddeck/launcher/gpu/guard/Probe.kt b/app/src/main/java/com/droiddeck/launcher/gpu/guard/Probe.kt
new file mode 100644
index 0000000..3c68cac
--- /dev/null
+++ b/app/src/main/java/com/droiddeck/launcher/gpu/guard/Probe.kt
@@ -0,0 +1,269 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+package com.droiddeck.launcher.gpu.guard
+
+import android.content.Context
+import android.os.Environment
+import com.droiddeck.launcher.core.FileUtils
+import com.droiddeck.launcher.core.HostProcess
+import com.droiddeck.launcher.gpu.LinuxVulkanDriver
+import com.droiddeck.launcher.runtime.LinuxRuntime
+import com.droiddeck.launcher.session.SessionPrefs
+import java.io.File
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+
+/**
+ * The pre-flight GPU probe: one small, logged, time-boxed piece of work pushed through the driver
+ * before gamescope and the Steam client are started.
+ *
+ * The point is not to prove the GPU works - `vulkaninfo` already says that much - it is to refuse
+ * to hand the experimental PanVK path a 700 MB client before it has finished one 4 KB fill. The
+ * fault that took this device down was a fence that was never signalled; a fence that is never
+ * signalled for a 4 KB buffer is the same failure, found in two seconds, with the phone still up.
+ *
+ * It is a proot invocation like any other, and the app - not the guest - owns the clock: the guest
+ * script has its own `timeout`s, and if the process is still alive when the budget runs out the app
+ * asks proot to wind its tree down and then kills it. A probe that hangs is itself an answer, and
+ * it is recorded as one.
+ */
+object Probe {
+    /** The script inside the runtime, staged fresh from the apk at every session start. */
+    private const val SCRIPT = "/usr/local/bin/droiddeck-gpu-probe"
+
+    /** Its exit code for "the GPU did not finish what was queued". */
+    private const val EXIT_FAILED = 78
+
+    /** `timeout`'s, and a SIGKILL's: the guest's own clock ran out. */
+    private const val EXIT_TIMEOUT = 124
+    private const val EXIT_KILLED = 137
+
+    class Result(
+        /** Whether a session may start. */
+        val ok: Boolean,
+        /** One line for the log, the page and the device report. */
+        val summary: String,
+        /** Everything the guest said, for the session's folder. */
+        val lines: List<String>,
+        /** The verdict, in the script's own words, when there is one. */
+        val verdict: String?,
+    ) {
+        /** The GPU was asked and did not answer - the one result that is evidence, not absence of it. */
+        val stalled: Boolean
+            get() = !ok && verdict != null && verdict.startsWith("DD_GPU_PROBE_SUBMIT_TIMEOUT")
+
+        val skipped: Boolean
+            get() = verdict != null && verdict.startsWith("DD_GPU_PROBE_SKIPPED")
+
+        companion object {
+            fun of(exit: Int, lines: List<String>): Result {
+                val verdict: String? = lines.lastOrNull { it.startsWith("DD_GPU_PROBE_") }
+                if (verdict == null) {
+                    return Result(false, "the probe produced no verdict (exit $exit)", lines, null)
+                }
+                val body = verdict.substringAfter(':').trim().ifEmpty { verdict }
+                val ok = verdict.startsWith("DD_GPU_PROBE_OK") || verdict.startsWith("DD_GPU_PROBE_SKIPPED")
+                return Result(ok, body, lines, verdict)
+            }
+        }
+    }
+
+    /**
+     * Runs the probe and waits. [timeoutMs] is a wall clock on the whole thing, including proot's
+     * own start; the guest's internal budgets are shorter, so a normal run ends well inside it.
+     *
+     * Must not be called on the main thread: it waits for a process.
+     */
+    /**
+     * A file that turns the probe off without the app: `droiddeck-no-gpu-probe` in the app's own
+     * external files directory, the place the session's other switch file lives. Every other
+     * escape from this guard is a switch inside the app, and a probe that has gone wrong is
+     * exactly the case where someone may not be able to get to them.
+     */
+    private fun skipFile(context: Context): File? =
+        if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.R)
+            context.getExternalFilesDir(null)?.let { File(it, "droiddeck-no-gpu-probe") }
+        else null
+
+    fun run(context: Context, profile: SafeProfile, timeoutMs: Long = 60_000L): Result {
+        val app = context.applicationContext
+        skipFile(app)?.takeIf { it.isFile }?.let {
+            val result = Result(true, "the probe is switched off by ${it.name}",
+                listOf("DD_GPU_PROBE_SKIPPED: ${it.name} is present"), "DD_GPU_PROBE_SKIPPED: switched off")
+            GpuGuard.noteProbe(app, result)
+            GpuGuardLog.log("probe", "skipped: ${it.name} is present")
+            return result
+        }
+        val root = LinuxRuntime.rootDir(app)
+        val script = File(root, SCRIPT.substring(1))
+        if (!script.isFile) {
+            return Result(true, "the probe is not in this runtime; skipped", listOf(
+                "DD_GPU_PROBE_SKIPPED: $SCRIPT is not present in the runtime (staged at session start)"),
+                "DD_GPU_PROBE_SKIPPED: script missing").also { GpuGuard.noteProbe(app, it) }
+        }
+
+        val runtimeDir = File(app.filesDir, ".wayland-rt").apply { mkdirs() }
+        val guest = ArrayList<String>()
+        guest.add("/usr/bin/env")
+        guest.add("-i")
+        guest.add("HOME=/root")
+        guest.add("USER=root")
+        guest.add("PATH=/usr/local/bin:/usr/bin:/bin")
+        guest.add("TERM=xterm-256color")
+        guest.add("LANG=C.UTF-8")
+        guest.add("TZ=" + java.util.TimeZone.getDefault().id)
+        guest.add("XDG_RUNTIME_DIR=" + LinuxRuntime.GUEST_RUNTIME_DIR)
+        // The driver the session would draw with, so the probe is not testing a different stack.
+        // Named twice on purpose: BL_VK_DRIVER is what the session script reads (and what the
+        // probe's python stage dlopens), VK_DRIVER_FILES is what the Vulkan loader `vulkaninfo`
+        // goes through reads. Setting only the first would leave enumeration pointed at the
+        // runtime's own driver, and the probe would fail over a name it never asked about.
+        LinuxVulkanDriver.resolveIcdPath(app, SessionPrefs.linuxDriver(app))?.let { icd ->
+            guest.add(LinuxVulkanDriver.ENV + "=" + icd)
+            guest.add("VK_DRIVER_FILES=" + icd)
+        }
+        if (guest.none { it.startsWith(LinuxVulkanDriver.ENV + "=") }) {
+            LinuxRuntime.vulkanIcd(app)?.let {
+                guest.add("VK_ICD_FILENAMES=" + it.path)
+                guest.add("VK_DRIVER_FILES=" + it.path)
+            }
+        }
+        guest.add("PANVK_KBASE_DRI3=0")
+        guest.add("MESA_LOADER_DRIVER_OVERRIDE=zink")
+        guest.add("GALLIUM_DRIVER=zink")
+        guest.add("LIBGL_KOPPER_DRI2=true")
+        guest.addAll(profile.envLines())
+        // The guest's own clocks, well inside the app's, so the app is never the first to give up.
+        guest.add("DD_GPU_PROBE_ENUM_SECONDS=20")
+        guest.add("DD_GPU_PROBE_SUBMIT_SECONDS=15")
+        guest.add(SCRIPT)
+        guest.add(profile.id)
+
+        val command = LinuxRuntime.command(
+            app, null, runtimeDir, Environment.getExternalStorageDirectory(), guest,
+        )
+        val hostEnv = ArrayList<String>()
+        hostEnv.add("PROOT_LOADER=" + LinuxRuntime.prootLoader(app).path)
+        hostEnv.add("PROOT_TMP_DIR=" + app.cacheDir.path)
+        val prootLibs = LinuxRuntime.prootLibraryPath(app)
+        if (prootLibs.isNotEmpty()) hostEnv.add("LD_LIBRARY_PATH=$prootLibs")
+
+        val lines = java.util.Collections.synchronizedList(ArrayList<String>())
+        val done = CountDownLatch(1)
+        var status: Int? = null
+        var pid = -1
+        try {
+            pid = HostProcess.start(
+                command.joinToString(" ") { it.replace("\\", "\\\\").replace(" ", "\\ ") },
+                hostEnv.toTypedArray(), root,
+                { value -> status = value; done.countDown() },
+                { line -> lines.add(line) },
+            )
+        } catch (e: Exception) {
+            val result = Result(true, "the probe could not be started: ${e.message}", lines,
+                "DD_GPU_PROBE_SKIPPED: could not be started")
+            GpuGuard.noteProbe(app, result)
+            return result
+        }
+        if (pid <= 1) {
+            val result = Result(true, "the probe process could not be started", lines,
+                "DD_GPU_PROBE_SKIPPED: process could not be started")
+            GpuGuard.noteProbe(app, result)
+            return result
+        }
+
+        val finished = try {
+            done.await(timeoutMs, TimeUnit.MILLISECONDS)
+        } catch (e: InterruptedException) {
+            false
+        }
+        if (!finished) {
+            GpuGuardLog.log("probe", "the probe did not finish in ${timeoutMs / 1000}s; taking it down")
+            killTree(pid)
+            runCatching { done.await(5, TimeUnit.SECONDS) }
+            val result = Result(false,
+                "the GPU did not answer the probe in ${timeoutMs / 1000}s (the process was still alive when the budget ran out)",
+                lines + "DD_GPU_PROBE_SUBMIT_TIMEOUT: the probe process was still alive after ${timeoutMs / 1000}s",
+                "DD_GPU_PROBE_SUBMIT_TIMEOUT: no answer in ${timeoutMs / 1000}s")
+            GpuGuard.noteProbe(app, result)
+            return result
+        }
+        killTree(pid)
+
+        val exit = status ?: -1
+        val result = when {
+            exit == EXIT_TIMEOUT || exit == EXIT_KILLED -> Result(false,
+                "the probe's own clock ran out (exit $exit)",
+                lines + "DD_GPU_PROBE_SUBMIT_TIMEOUT: exit $exit",
+                "DD_GPU_PROBE_SUBMIT_TIMEOUT: exit $exit")
+            exit == 0 || exit == EXIT_FAILED -> Result.of(exit, ArrayList(lines))
+            else -> Result(true, "the probe exited $exit; treated as a skip", lines,
+                "DD_GPU_PROBE_SKIPPED: exit $exit")
+        }
+        GpuGuard.noteProbe(app, result)
+        return result
+    }
+
+    /**
+     * proot's `--kill-on-exit` only runs if proot gets to run it, and SIGKILL never lets it. So:
+     * SIGTERM to proot, which takes its tracees with it, then SIGKILL to whatever is left of the
+     * tree a moment later. Nothing here touches a process that is not under [rootPid].
+     */
+    private fun killTree(rootPid: Int) {
+        signal(rootPid, 15)
+        try {
+            Thread.sleep(1200)
+        } catch (e: InterruptedException) {
+            return
+        }
+        for (pid in descendants(rootPid).sortedDescending()) signal(pid, 9)
+        signal(rootPid, 9)
+    }
+
+    private fun descendants(root: Int): Set<Int> {
+        val parent = HashMap<Int, Int>()
+        File("/proc").listFiles()?.forEach { entry ->
+            val pid = entry.name.toIntOrNull() ?: return@forEach
+            val stat = try {
+                File(entry, "stat").readText()
+            } catch (e: Exception) {
+                return@forEach
+            }
+            stat.substringAfterLast(") ").split(' ').getOrNull(1)?.toIntOrNull()?.let { parent[pid] = it }
+        }
+        val out = HashSet<Int>()
+        out.add(root)
+        var grew = true
+        while (grew) {
+            grew = false
+            for ((pid, ppid) in parent) if (ppid in out && out.add(pid)) grew = true
+        }
+        out.remove(root)
+        return out
+    }
+
+    /** SIGTERM/SIGKILL by pid; `android.os.Process.sendSignal` is hidden, `killProcess` is SIGKILL. */
+    private fun signal(pid: Int, which: Int) {
+        if (pid <= 1) return
+        try {
+            Class.forName("android.os.Process")
+                .getMethod("sendSignal", Int::class.javaPrimitiveType, Int::class.javaPrimitiveType)
+                .invoke(null, pid, which)
+        } catch (e: Exception) {
+            try {
+                android.os.Process.killProcess(pid)
+            } catch (ignored: Exception) {
+            }
+        }
+    }
+
+    /** The probe's own output, into the session folder, so a bug report carries it. */
+    fun write(dir: File?, result: Result) {
+        val file = dir?.let { File(it, "gpu-probe.log") } ?: return
+        try {
+            file.parentFile?.mkdirs()
+            FileUtils.writeString(file, result.lines.joinToString("\n") + "\n")
+        } catch (e: Exception) {
+            GpuGuardLog.log("probe", "the probe log could not be written: $e")
+        }
+    }
+}
