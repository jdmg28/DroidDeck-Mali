diff --git a/tools/lavapipe/check_archive.py b/tools/lavapipe/check_archive.py
new file mode 100644
index 0000000..7993fdc
--- /dev/null
+++ b/tools/lavapipe/check_archive.py
@@ -0,0 +1,76 @@
+#!/usr/bin/env python3
+"""Read the built zip the way the importer will, and refuse it here if it would be refused there.
+
+Every rule below mirrors a check that lives in Java (DriverArchivePolicy and the reconciliation in
+LinuxVulkanDriverManager.adopt). They are worth re-running on the artifact because the two ways a
+packaged driver goes wrong are both silent at build time: a library in the archive that meta.json does
+not declare (adopt() refuses the import, so the user sees a rejection with no clue that CI built it),
+and a field shaped slightly off, which the importer keeps quietly at its default instead of failing.
+"""
+import argparse
+import json
+import re
+import sys
+import zipfile
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("archive")
+    args = ap.parse_args()
+
+    with zipfile.ZipFile(args.archive) as zf:
+        names = sorted(n for n in zf.namelist() if not n.endswith("/"))
+        try:
+            meta = json.loads(zf.read("meta.json"))
+        except Exception as exc:                                    # noqa: BLE001
+            sys.exit("no readable meta.json at the top level of %s (%s): the importer looks for exactly "
+                     "that path" % (args.archive, exc))
+
+    problems = []
+    libraries = [n for n in names if re.search(r"\.so(\.[0-9.]+)?$", n)]
+    for n in names:
+        if "/" in n:
+            problems.append("%s is nested; the importer only reads the top level" % n)
+    if meta.get("kind") != "linux-vulkan-icd":
+        problems.append("kind is %r; the importer will not treat this as a Linux ICD" % meta.get("kind"))
+    drivers = [n for n in libraries if n.startswith("libvulkan_")]
+    if len(drivers) != 1:
+        problems.append("the importer wants exactly one libvulkan_*.so and the archive has %s" % drivers)
+    main_lib = meta.get("libraryName", "")
+    if main_lib not in names:
+        problems.append("libraryName is %r and no such file is in the archive" % main_lib)
+    companions = list(meta.get("companions", []))
+    for declared in companions:
+        if declared not in names:
+            problems.append("meta.json declares %s and the archive does not carry it" % declared)
+    for lib in libraries:
+        if lib not in [main_lib] + companions:
+            problems.append("%s is in the archive but undeclared - adopt() refuses the package over "
+                            "this, by design, so that nothing the app has no rule for is loaded "
+                            "because it happened to be next door" % lib)
+    if not re.match(r"^\d+\.\d+$", str(meta.get("minGlibc", ""))):
+        problems.append("minGlibc %r is not a version: droiddeck-session compares the guest's glibc "
+                        "against it, and an unparseable value is an off switch" % meta.get("minGlibc"))
+    if not re.match(r"^1\.[0-4]\.\d+$", str(meta.get("vulkanApiVersion", ""))):
+        problems.append("vulkanApiVersion %r is outside the form apiVersion() keeps; anything else is "
+                        "dropped in favour of the default" % meta.get("vulkanApiVersion"))
+    if meta.get("libc") != "glibc":
+        problems.append("libc is %r; a bionic build cannot load in the guest" % meta.get("libc"))
+    sha = meta.get("sha256", {})
+    for name in [main_lib] + companions:
+        if name in sha and not re.fullmatch(r"[0-9a-f]{64}", str(sha[name])):
+            problems.append("meta.json's sha256 for %s is not a digest" % name)
+
+    if problems:
+        for problem in problems:
+            print("REFUSED: " + problem, file=sys.stderr)
+        return 1
+    print("OK: %s - %d librar%s, one libvulkan_*.so, minGlibc %s, ICD api %s, companions declared both "
+          "ways" % (meta.get("name"), len(libraries), "y" if len(libraries) == 1 else "ies",
+                    meta.get("minGlibc"), meta.get("vulkanApiVersion")))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/lavapipe/check_glibc.py b/tools/lavapipe/check_glibc.py
new file mode 100644
index 0000000..b9fab30
--- /dev/null
+++ b/tools/lavapipe/check_glibc.py
@@ -0,0 +1,189 @@
+#!/usr/bin/env python3
+"""Decide whether a rootfs can actually load the libraries about to be shipped in a driver zip.
+
+One comparison matters and it is not subtle: the highest GLIBC_* symbol version the object references
+against the highest one the runtime's libc offers. A driver that needs more than the rootfs has does
+not fail politely - it fails inside the guest, in the loader, thirty seconds into a session, with a
+line in a log nobody reads until after the phone has rebooted. So this refuses to package.
+
+Both sides come from scanning the files' bytes for `GLIBC_<major>.<minor>`, which needs no binutils
+and works the same on either side:
+
+  * in libc.so.6 that string set is the list of versions the library *defines*;
+  * in a driver it is the list it *asks for*.
+
+The asymmetry is worth knowing: a stray `GLIBC_2.40` in some Mesa warning string would make the
+requirement look larger than it is, and the error is therefore always in the direction of refusing to
+ship - which is the only direction that costs nothing here.
+
+Usage:
+  check_glibc.py --rootfs-libc libc.so.6 --rootfs-libdir rootfs/usr/lib \\
+                 --lib libvulkan_lvp.so --lib libLLVM.so.19.1 --provides libLLVM.so.19.1
+
+Exit 0 = ship it. 1 = do not (something is missing or newer than the runtime). 2 = the rootfs was not
+readable, which is only acceptable with --allow-unverified, and never silently.
+"""
+import argparse
+import os
+import re
+import subprocess
+import sys
+
+GLIBC_RE = re.compile(rb"GLIBC_(\d+)\.(\d+)")
+NEEDED_PREFIX = b"NEEDED"
+
+
+def max_version(path):
+    """The highest GLIBC_x.y appearing in a file, as (major, minor); None when the file has none."""
+    best = None
+    with open(path, "rb") as handle:
+        tail = b""
+        while True:
+            chunk = handle.read(1 << 20)
+            if not chunk:
+                break
+            data = tail + chunk
+            for m in GLIBC_RE.finditer(data):
+                found = (int(m.group(1)), int(m.group(2)))
+                if best is None or found > best:
+                    best = found
+            tail = data[-16:]        # a version string must not be cut in half by the chunk edge
+    return best
+
+
+def sonames_in(dirs):
+    """Every `lib*.so*` file name anywhere under the given rootfs directories."""
+    names = set()
+    for base in dirs:
+        for _root, _dirs, files in os.walk(base):
+            for f in files:
+                if ".so" in f:
+                    names.add(f)
+    return names
+
+
+def needed_by(path, readelf):
+    """The NEEDED entries of an ELF object, via binutils; None when binutils is not on hand."""
+    try:
+        out = subprocess.run([readelf, "-d", "-W", path], capture_output=True, check=True).stdout
+    except (OSError, subprocess.CalledProcessError):
+        return None
+    found = []
+    for line in out.splitlines():
+        text = line.decode("utf-8", "replace")
+        if "NEEDED" in text:
+            m = re.search(r"\[([^\]]+)\]", text)
+            if m:
+                found.append(m.group(1))
+    return found
+
+
+def fmt(v):
+    return "none" if v is None else "%d.%d" % v
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--rootfs-libc", default="",
+                    help="libc.so.6 as extracted from the runtime; omit it for report mode, where the "
+                         "requirement is measured and printed but nothing is compared")
+    ap.add_argument("--rootfs-libdir", action="append", default=[], help="dir to search for NEEDED libs")
+    ap.add_argument("--lib", action="append", default=[], help="library being shipped, checked and reported")
+    ap.add_argument("--provides", action="append", default=[], help="sonames the zip itself supplies")
+    ap.add_argument("--allow-missing", action="append", default=[], help="sonames allowed to be absent")
+    ap.add_argument("--allow-unverified", action="store_true",
+                    help="treat an unreadable rootfs as a warning instead of a refusal")
+    args = ap.parse_args()
+
+    lines = []
+    problems = []
+    unverified = False
+    comparing = bool(args.rootfs_libc)
+    if not comparing:
+        have = None
+    elif not os.path.isfile(args.rootfs_libc):
+        unverified = True
+        have = None
+    else:
+        have = max_version(args.rootfs_libc)
+
+    shipped = set(args.provides)
+    present = sonames_in(args.rootfs_libdir) if args.rootfs_libdir else set()
+    if args.rootfs_libdir and not present:
+        problems.append("no libraries found under %s - the rootfs extraction is wrong, and an empty "
+                        "list is not evidence that the driver's dependencies are missing"
+                        % ", ".join(args.rootfs_libdir))
+
+    rows = []
+    for lib in args.lib:
+        if not os.path.isfile(lib):
+            problems.append("missing library to check: %s" % lib)
+            continue
+        want = max_version(lib)
+        rows.append((os.path.basename(lib), os.path.getsize(lib), want))
+        if want and have and want > have:
+            # The only failure a driver can have that the loader will report as "version not found".
+            problems.append("%s references GLIBC_%s, but the runtime's libc only goes to %s. "
+                            "The loader will refuse it inside the guest; build the driver against a "
+                            "matching toolchain or ship it to a newer runtime, do not install it and "
+                            "see." % (os.path.basename(lib), fmt(want), fmt(have)))
+        needed = needed_by(lib, "readelf")
+        if needed is None:
+            lines.append("  (readelf unavailable: NEEDED of %s was not checked)" % os.path.basename(lib))
+            continue
+        for dep in needed:
+            if dep in present or dep in shipped or dep in args.allow_missing:
+                continue
+            problems.append("%s needs %s and the runtime does not have it (nor does the zip provide "
+                            "it). Find the package that carries it, or do not ship this driver."
+                            % (os.path.basename(lib), dep))
+
+    summary = ["### lavapipe compatibility", "",
+               "| what | value |", "|---|---|",
+               "| runtime glibc (highest version its libc defines) | %s |" % fmt(have)]
+    for name, size, want in rows:
+        summary.append("| %s | %.1f MB, needs at most GLIBC_%s |" % (name, size / 1e6, fmt(want)))
+    summary.append("")
+    if unverified:
+        summary.append("**The runtime could not be inspected**: %s is not readable, so nothing above "
+                       "was compared against a real glibc." % args.rootfs_libc)
+    elif not comparing:
+        summary.append("**Report mode**: no runtime libc was given, so the numbers above are the "
+                       "requirement this package puts on a rootfs, not a verdict on any particular one. "
+                       "The comparison that decides whether it loads is made on the device, by the "
+                       "session script, against the glibc the guest actually has - CI cannot know it, "
+                       "because the rootfs is the user's.")
+    if problems or unverified:
+        summary.append("**Refused:**")
+        summary += ["- %s" % p for p in problems]
+    else:
+        summary.append("**OK**: every library's GLIBC requirement is inside what the runtime provides, "
+                       "and every NEEDED entry is either in the runtime or shipped by the zip.")
+    report = "\n".join(summary) + "\n"
+
+    out = os.environ.get("GITHUB_STEP_SUMMARY")
+    if out:
+        with open(out, "a", encoding="utf-8") as handle:
+            handle.write(report)
+    print(report)
+    for line in lines:
+        print(line)
+
+    if unverified and not problems:
+        # The one case where a caller may decide to go ahead: it has to say so with a flag, and the
+        # exit code still distinguishes it from a real pass (0 = checked and fine, 2 = not checked).
+        if args.allow_unverified:
+            print("::warning::the runtime could not be inspected; packaging continues because "
+                  "--allow-unverified was passed")
+            return 0
+        print("REFUSED: the runtime's libc (%s) could not be read, so the glibc requirement is "
+              "unverified. Fix the rootfs extraction, or pass --allow-unverified if you mean to ship "
+              "a driver nobody checked." % args.rootfs_libc, file=sys.stderr)
+        return 2
+    for problem in problems:
+        print("REFUSED: " + problem, file=sys.stderr)
+    return 1 if problems else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/lavapipe/check_sizes.py b/tools/lavapipe/check_sizes.py
new file mode 100644
index 0000000..ad05a6d
--- /dev/null
+++ b/tools/lavapipe/check_sizes.py
@@ -0,0 +1,107 @@
+#!/usr/bin/env python3
+"""Refuse a package the app would refuse, before it is published.
+
+Two questions, both asked of the archive rather than of the intention: is anything too big, and is
+anything in there that the importer has no rule for?
+
+The importer in LinuxVulkanDriverManager enforces three limits, all of them in DriverArchivePolicy,
+and all of them read out of the *Java source* here rather than copied into this file: a packaging gate
+that carries its own numbers drifts out of agreement with the app, and then either publishes a zip
+that will be refused or refuses one that would have worked. If a constant is ever renamed, this stops
+with "could not read" instead of defaulting to something.
+
+Usage: check_sizes.py --archive out.zip --stage stage --policy path/to/DriverArchivePolicy.java \
+                     [--zip package.zip]
+
+--zip is the optional third look: the file names inside the archive are compared against what meta.json
+declares, because an undeclared library in the zip is a refusal at import time on the phone, and
+"adopt() reconciles both directions" only helps if the packager knew to look.
+"""
+import argparse
+import os
+import re
+import sys
+
+
+def limits_from_java(path):
+    src = open(path, "r", encoding="utf-8", errors="replace").read()
+    found = {}
+    for name in ("MAX_ARCHIVE_BYTES", "MAX_LIBRARY_BYTES", "MAX_META_BYTES", "MAX_COMPANIONS"):
+        m = re.search(name + r'\s*=\s*(\d+)L?\s*(?:(?:<<\s*(\d+))|(?:\*\s*1024\s*\*\s*1024))?', src)
+        if not m:
+            sys.exit("could not read %s out of %s - the importer's limits changed shape, and this "
+                     "gate has to change with them (it refuses to guess them)" % (name, path))
+        value = int(m.group(1))
+        found[name] = value << int(m.group(2)) if m.group(2) else value
+    return found
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--archive", required=True)
+    ap.add_argument("--stage", required=True)
+    ap.add_argument("--policy", required=True)
+    ap.add_argument("--zip", default="", help="the built archive, to check its contents against meta.json")
+    args = ap.parse_args()
+
+    lim = limits_from_java(args.policy)
+    rows = ["### Package size", "",
+            "| file | bytes | limit |", "|---|---|---|"]
+    bad = []
+    for name in sorted(os.listdir(args.stage)):
+        size = os.path.getsize(os.path.join(args.stage, name))
+        cap = lim["MAX_META_BYTES"] if name == "meta.json" else lim["MAX_LIBRARY_BYTES"]
+        rows.append("| %s | %s | %s |" % (name, format(size, ","), format(cap, ",")))
+        if size > cap:
+            bad.append("%s is %s bytes over the %s limit" % (name, format(size - cap, ","),
+                                                              "meta.json" if name == "meta.json"
+                                                              else "per-library"))
+    total = os.path.getsize(args.archive)
+    rows.append("| **archive** | %s | %s |" % (format(total, ","), format(lim["MAX_ARCHIVE_BYTES"], ",")))
+    if total > lim["MAX_ARCHIVE_BYTES"]:
+        bad.append("the archive is %s bytes over MAX_ARCHIVE_BYTES" % format(total - lim["MAX_ARCHIVE_BYTES"], ","))
+    if args.zip:
+        import json
+        import zipfile
+        try:
+            with zipfile.ZipFile(args.zip) as zf:
+                names = [n for n in zf.namelist() if not n.endswith("/")]
+                meta = json.loads(zf.read("meta.json"))
+        except Exception as exc:            # noqa: BLE001 - the message is the deliverable here
+            sys.exit("cannot read %s as the zip the app will read: %s" % (args.zip, exc))
+        declared = set([meta.get("libraryName", "")] + list(meta.get("companions", [])))
+        allowed = declared | {"meta.json", "NOTICE.txt", "LICENSE", "LICENSE.txt"}
+        for name in names:
+            base = os.path.basename(name)
+            if "/" in name:
+                bad.append("%s is not at the top level of the archive, where the importer looks" % name)
+            elif base not in allowed:
+                bad.append("%s is in the zip but not declared in meta.json - adopt() refuses a package "
+                           "carrying a library nobody accounted for, which is the right answer for the "
+                           "phone and a bad one for a published artifact" % base)
+        extra = len(meta.get("companions", [])) - lim["MAX_COMPANIONS"]
+        if extra > 0:
+            bad.append("%d companions, %d over MAX_COMPANIONS" % (len(meta.get("companions", [])), extra))
+        rows.append("")
+        rows.append("Contents of `%s`: %d file(s), all of them declared in meta.json."
+                    % (os.path.basename(args.zip), len(names)))
+    rows.append("")
+    if bad:
+        rows.append("**Refused:** " + "; ".join(bad))
+    else:
+        rows.append("**OK**: every file fits inside the limits the importer enforces.")
+    report = "\n".join(rows) + "\n"
+    out = os.environ.get("GITHUB_STEP_SUMMARY")
+    if out:
+        with open(out, "a", encoding="utf-8") as handle:
+            handle.write(report)
+    print(report)
+    if bad:
+        for b in bad:
+            print("REFUSED: " + b, file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/lavapipe/make_meta.py b/tools/lavapipe/make_meta.py
new file mode 100644
index 0000000..f6516b9
--- /dev/null
+++ b/tools/lavapipe/make_meta.py
@@ -0,0 +1,57 @@
+#!/usr/bin/env python3
+"""Write the meta.json the DroidDeck driver importer expects next to the staged libraries.
+
+Kept as a file rather than a heredoc in the workflow for one reason: the workflow's `run: |` block is
+indented, and Python reads indentation as syntax.
+
+The fields are not decoration. `kind` is what makes the importer treat the zip as a Linux ICD at all;
+`libraryName` must equal the file on disk because the object is renamed to it; `companions` is the
+list adopt() reconciles against the archive, in both directions, so a file in the zip that is not
+declared here is a refusal, not a silent drop; `minGlibc` is what the app shows before installing.
+"""
+import argparse
+import hashlib
+import json
+import pathlib
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--stage", required=True)
+    ap.add_argument("--main-library", required=True)
+    ap.add_argument("--companion", action="append", default=[])
+    ap.add_argument("--suite", default="trixie")
+    ap.add_argument("--mesa-version", default="")
+    ap.add_argument("--llvm-soname", default="")
+    ap.add_argument("--min-glibc", default="", help="highest GLIBC_* the libraries reference, if known")
+    ap.add_argument("--name", default="")
+    args = ap.parse_args()
+
+    stage = pathlib.Path(args.stage)
+    def sha(name):
+        return hashlib.sha256((stage / name).read_bytes()).hexdigest()
+
+    meta = {
+        "schemaVersion": 1,
+        "kind": "linux-vulkan-icd",
+        "name": args.name or ("Software Vulkan (Mesa lavapipe, Debian %s)" % args.suite),
+        "driverVersion": "Mesa %s / %s" % (args.mesa_version or "?", args.llvm_soname or "?"),
+        "minGlibc": args.min_glibc,
+        "libc": "glibc",
+        "vulkanApiVersion": "1.3.204",
+        "libraryName": args.main_library,
+        "companions": list(args.companion),
+        "gpuVendor": "software",
+        "note": ("llvmpipe behind Vulkan: nothing that draws through this touches the GPU. Slow on "
+                 "purpose - it is a way to test Steam, FEX, Proton and the games with the vendor "
+                 "driver out of the picture, not a way to play."),
+        "sha256": {n: sha(n) for n in [args.main_library] + list(args.companion)
+                   if (stage / n).is_file()},
+    }
+    (stage / "meta.json").write_text(json.dumps(meta, indent=2) + "\n")
+    print("meta.json: %s + %s, %d companion(s)" % (args.main_library, meta["driverVersion"],
+                                                    len(args.companion)))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/lavapipe/min_glibc.py b/tools/lavapipe/min_glibc.py
new file mode 100644
index 0000000..4499ca1
--- /dev/null
+++ b/tools/lavapipe/min_glibc.py
@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+"""Take the requirement out of check_glibc.py's report and write it as the package's minGlibc.
+
+A separate script for a boring reason: the workflow's `run: |` blocks are indented, and Python reads
+indentation as syntax - an inline heredoc is a one-character mistake away from being a SyntaxError in
+a step nobody re-runs.
+
+Refuses to produce a blank answer. minGlibc is the number droiddeck-session compares the guest's own
+glibc against, so writing "" here would silently turn the device-side check off, which is the opposite
+of the point.
+"""
+import argparse
+import re
+import sys
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--report", required=True, help="check_glibc.py's output, captured")
+    ap.add_argument("--out", required=True, help="file to write the version into")
+    args = ap.parse_args()
+
+    text = open(args.report, encoding="utf-8", errors="replace").read()
+    found = [tuple(map(int, m.groups()))
+             for m in re.finditer(r"needs at most GLIBC_(\d+)\.(\d+)", text)]
+    if not found:
+        sys.exit("the report names no GLIBC requirement, so minGlibc would be a guess. Fix the report "
+                 "step (exit %s) rather than publishing a driver whose device-side check is disabled."
+                 % ("?"))
+    best = max(found)
+    with open(args.out, "w", encoding="utf-8") as handle:
+        handle.write("%d.%d" % best)
+    print("minGlibc = %d.%d (the highest of %s measured in this package)"
+          % (best[0], best[1], ", ".join("%d.%d" % v for v in sorted(set(found)))))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/lavapipe/pick_deb.py b/tools/lavapipe/pick_deb.py
new file mode 100644
index 0000000..722442b
--- /dev/null
+++ b/tools/lavapipe/pick_deb.py
@@ -0,0 +1,71 @@
+#!/usr/bin/env python3
+"""Pick one package out of a Debian `Packages` index and print what CI needs to download it.
+
+Written as a script rather than inline because the alternative is a wall of awk in a workflow, and
+this decides which Mesa build ends up on a phone that reboots when its GPU faults: a silent
+"whatever is newest" is exactly how a version nobody read gets shipped.
+
+  pick_deb.py --packages Packages --package mesa-vulkan-drivers --expect-version 25.0.7
+
+prints KEY=VALUE lines (VERSION, FILENAME, SIZE, SHA256) on stdout, and with --expect-version it
+exits 1 when the archive's version does not start with that string - printing what it found instead,
+so the failure says which version is actually in the suite. --expect-version "" accepts anything.
+"""
+import argparse
+import os
+import sys
+
+
+def read_records(path):
+    """Debian's index is stanzas separated by blank lines; fields are `Key: value`."""
+    text = open(path, "r", encoding="utf-8", errors="replace").read()
+    for stanza in text.split("\n\n"):
+        record = {}
+        for line in stanza.split("\n"):
+            if not line or line.startswith(" "):
+                continue                      # continuation lines belong to the previous field
+            key, _, value = line.partition(":")
+            record[key.strip()] = value.strip()
+        if record.get("Package"):
+            yield record
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--packages", required=True, help="the (decompressed) Packages index")
+    ap.add_argument("--package", required=True)
+    ap.add_argument("--expect-version", default="", help="refuse unless the version starts with this")
+    ap.add_argument("--arch", default="arm64")
+    args = ap.parse_args()
+
+    if not os.path.isfile(args.packages):
+        sys.exit("no Packages index at %s - the download failed, and guessing is not a fallback"
+                 % args.packages)
+
+    wanted = [r for r in read_records(args.packages)
+              if r["Package"] == args.package and r.get("Architecture", args.arch) == args.arch]
+    if not wanted:
+        sys.exit("package %s (%s) is not in that index at all" % (args.package, args.arch))
+    if len(wanted) > 1:
+        sys.exit("package %s appears %d times (multiple suites in one index?); refusing to pick: %s"
+                 % (args.package, len(wanted), ", ".join(r.get("Version", "?") for r in wanted)))
+
+    rec = wanted[0]
+    version, filename = rec.get("Version", ""), rec.get("Filename", "")
+    if not filename:
+        sys.exit("index entry for %s has no Filename" % args.package)
+    if args.expect_version and not version.startswith(args.expect_version):
+        sys.exit("%s in the archive is version %s, not %s. The packaging was asked to produce a "
+                 "specific Mesa build; look at what changed before shipping this on a device whose "
+                 "GPU fault reboots the phone. (Pass --expect-version '' to accept %s.)"
+                 % (args.package, version, args.expect_version, version))
+
+    print("VERSION=%s" % version)
+    print("FILENAME=%s" % filename)
+    print("SIZE=%s" % rec.get("Size", "0"))
+    print("SHA256=%s" % rec.get("SHA256", ""))
+    print("PKG=%s" % args.package)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/lavapipe/test_lavapipe_tools.sh b/tools/lavapipe/test_lavapipe_tools.sh
new file mode 100644
index 0000000..db423d9
--- /dev/null
+++ b/tools/lavapipe/test_lavapipe_tools.sh
@@ -0,0 +1,261 @@
+#!/usr/bin/env bash
+# Tests for the two scripts the lavapipe packaging workflow trusts its judgement to.
+#
+# They are worth testing separately because a bug in them is not a crash: it is a driver that gets
+# packaged anyway and then fails inside the guest, or a good driver refused forever. Both look like
+# success from CI's point of view. Everything here is synthetic - no downloads, no network, a second
+# of runtime - including a case built to sit exactly on the chunk boundary of the byte scanner.
+set -u
+HERE="$(cd "$(dirname "$0")" && pwd)"
+W="$(mktemp -d)"; trap 'rm -rf "$W"' EXIT
+FAILED=0
+
+ok()   { echo "  ok   $1"; }
+fail() { echo "  FAIL $1"; FAILED=1; }
+
+# ---- a Packages index in the shape Debian writes: stanzas, continuation lines, two arches --------
+cat > "$W/Packages" <<'IDX'
+Package: libllvm19
+Version: 1:19.1.7-3
+Architecture: arm64
+Filename: pool/main/l/llvm-toolchain-19/libllvm19_19.1.7-3_arm64.deb
+Size: 44000000
+SHA256: aaaa
+
+Package: mesa-vulkan-drivers
+Version: 25.0.7-1
+Architecture: arm64
+Multi-Arch: same
+Description: Mesa Vulkan drivers
+ This continuation line must not become a field.
+Filename: pool/main/m/mesa/mesa-vulkan-drivers_25.0.7-1_arm64.deb
+Size: 3000000
+SHA256: bbbb
+
+Package: mesa-vulkan-drivers
+Version: 25.0.7-1
+Architecture: amd64
+Filename: pool/main/m/mesa/mesa-vulkan-drivers_25.0.7-1_amd64.deb
+Size: 3100000
+IDX
+
+out=$(python3 "$HERE/pick_deb.py" --packages "$W/Packages" --package mesa-vulkan-drivers \
+        --expect-version 25.0.7 2>&1); st=$?
+if [ "$st" = 0 ] && printf '%s' "$out" | grep -qx "VERSION=25.0.7-1" \
+   && printf '%s' "$out" | grep -q "FILENAME=pool/main/m/mesa/" \
+   && ! printf '%s' "$out" | grep -q "amd64"; then
+    ok "picks the arm64 record and only its fields"
+else
+    fail "picks the arm64 record and only its fields"; printf '%s\n' "$out" | sed 's/^/       /'
+fi
+
+python3 "$HERE/pick_deb.py" --packages "$W/Packages" --package mesa-vulkan-drivers \
+    --expect-version 25.2.0 >"$W/o" 2>&1; st=$?
+if [ "$st" = 1 ] && grep -q "is version 25.0.7-1, not 25.2.0" "$W/o"; then
+    ok "refuses a suite that moved off the pinned Mesa, and names what it found"
+else
+    fail "refuses a suite that moved off the pinned Mesa"; cat "$W/o" | sed 's/^/       /'
+fi
+
+python3 "$HERE/pick_deb.py" --packages "$W/Packages" --package mesa-vulkan-drivers \
+    --expect-version "" >/dev/null 2>&1 && ok "accepts anything when no version is pinned" \
+    || fail "accepts anything when no version is pinned"
+
+printf '\nPackage: mesa-vulkan-drivers\nVersion: 25.1.0-1\nArchitecture: arm64\nFilename: x\n\n' \
+    >> "$W/Packages"
+python3 "$HERE/pick_deb.py" --packages "$W/Packages" --package mesa-vulkan-drivers \
+    --expect-version "" >"$W/o" 2>&1; st=$?
+if [ "$st" = 1 ] && grep -q "appears 2 times" "$W/o"; then
+    ok "refuses to guess between two matching records (the continuation line did not split one)"
+else
+    fail "refuses to guess between two matching records"; sed 's/^/       /' "$W/o"
+fi
+
+# ---- the glibc gate -------------------------------------------------------------------------------
+# A rootfs libc defining 2.28..2.39, and a driver asking for 2.40: the exact case that must not ship.
+python3 - "$W" <<'PY'
+import pathlib, sys
+w = pathlib.Path(sys.argv[1])
+(w / "libc.so.6").write_bytes(b"GLIBC_2.28 GLIBC_2.34 GLIBC_2.39 " + b"\0" * 200)
+(w / "new.so").write_bytes(b"GLIBC_2.40 needed " + b"\0" * 100)
+(w / "old.so").write_bytes(b"GLIBC_2.31 needed " + b"\0" * 100)
+# And the boundary case: a version string split by the scanner's own 1 MiB chunk, which is the one
+# thing about a hand-written byte scan that could silently miss the highest number.
+edge = bytearray(b"\0" * (1 << 20))
+edge[(1 << 20) - 6:(1 << 20) + 4] = b"GLIBC_2.40"
+(w / "edge.so").write_bytes(bytes(edge))
+rootfs = w / "rootfs"
+for name in ("libfoo.so.1", "libbar.so.2"):
+    p = rootfs / "usr" / "lib" / "aarch64-linux-gnu" / name
+    p.parent.mkdir(parents=True, exist_ok=True)
+    p.write_bytes(b"\x7fELF")
+PY
+
+check() {   # check <expect-exit> <label> <args...>
+    local want="$1" label="$2"; shift 2
+    local out status
+    out=$(python3 "$HERE/check_glibc.py" "$@" 2>&1); status=$?
+    if [ "$status" = "$want" ]; then
+        ok "$label"
+    else
+        fail "$label (exit $status, wanted $want)"; printf '%s\n' "$out" | sed 's/^/       /'
+    fi
+    LAST_OUT="$out"
+}
+
+check 1 "a driver needing a newer glibc than the runtime has is refused" \
+    --rootfs-libc "$W/libc.so.6" --rootfs-libdir "$W/rootfs/usr/lib" --lib "$W/new.so"
+printf '%s\n' "$LAST_OUT" | grep -q "only goes to 2.39" \
+    && ok "  ...and the message says both numbers" || fail "  ...and the message says both numbers"
+
+check 0 "an older build passes" \
+    --rootfs-libc "$W/libc.so.6" --rootfs-libdir "$W/rootfs/usr/lib" --lib "$W/old.so"
+
+# The boundary case is a *refusal* (2.40 > the fake runtime's 2.39) - what it proves is that the
+# scanner saw the number at all, cut as it is across the 1 MiB chunk edge. A scanner that missed it
+# would exit 0 here, which is the silent failure worth testing for.
+check 1 "a version string split across the scanner's chunk boundary is still found" \
+    --rootfs-libc "$W/libc.so.6" --rootfs-libdir "$W/rootfs/usr/lib" --lib "$W/edge.so"
+printf '%s\n' "$LAST_OUT" | grep -q "needs at most GLIBC_2.40" \
+    && ok "  ...and it is the number the refusal quotes" || fail "  ...and it quotes the number"
+
+# A real ELF, so the NEEDED list is not something this test invented: this glibc needs exactly
+# ld-linux-x86-64.so.2, which is absent from the fake rootfs and present in the next run.
+REAL=$(readlink -f /lib/*/libc.so.6 /lib/libc.so.6 2>/dev/null | head -1)
+if [ -n "$REAL" ] && command -v readelf >/dev/null; then
+    check 1 "a NEEDED library neither the runtime nor the zip provides is refused" \
+        --rootfs-libc "$W/libc.so.6" --rootfs-libdir "$W/rootfs/usr/lib" --lib "$REAL"
+    printf 'cp "$W/../" /dev/null 2>/dev/null; mkdir -p "$W/rootfs/usr/lib/ld" && touch \
+        "$W/rootfs/usr/lib/ld/ld-linux-x86-64.so.2"
+' > /dev/null
+    mkdir -p "$W/rootfs/usr/lib/ld" && touch "$W/rootfs/usr/lib/ld/ld-linux-x86-64.so.2"
+    check 0 "  ...and passes once the runtime has it" \
+        --rootfs-libc "$W/libc.so.6" --rootfs-libdir "$W/rootfs/usr/lib" --lib "$REAL"
+    rm -rf "$W/rootfs/usr/lib/ld"
+    # --provides is how the zip declares "the companion covers this": the same refusal must go away.
+    NEEDS=$(readelf -d -W "$REAL" | sed -n 's/.*NEEDED.*\[\(.*\)\].*/\1/p' | head -1)
+    check 0 "a dependency the zip itself supplies is not held against it" \
+        --rootfs-libc "$W/libc.so.6" --rootfs-libdir "$W/rootfs/usr/lib" --lib "$REAL" \
+        --provides "$NEEDS"
+else
+    echo "  skip NEEDED cases (no readelf or no /lib libc here)"
+fi
+check 1 "an empty rootfs directory is called out instead of read as 'nothing is needed'" \
+    --rootfs-libc "$W/libc.so.6" --rootfs-libdir "$W/nope" --lib "$W/old.so"
+# Report mode is what the packaging workflow runs: CI has no way to know which rootfs the phone will
+# have, so it measures the requirement and says so, instead of inventing a runtime to compare against.
+check 0 "without --rootfs-libc it reports the requirement and passes" \
+    --lib "$W/new.so" --rootfs-libdir "$W/rootfs/usr/lib"
+printf '%s\n' "$LAST_OUT" | grep -qF "Report mode" \
+    && ok "  ...and says plainly that nothing was compared" || fail "  ...says plainly nothing was compared"
+check 1 "report mode still refuses a dependency nobody provides" \
+    --lib "$W/old.so" --rootfs-libdir "$W/nope"
+check 2 "an unreadable rootfs is a loud 2, not a 0, and names the reason" \
+    --rootfs-libc "$W/absent" --lib "$W/old.so"
+printf '%s\n' "$LAST_OUT" | grep -q "unverified" \
+    && ok "  ...and the message says the requirement is unverified" || fail "  ...says so"
+check 0 "and only a warning when someone passes --allow-unverified on purpose" \
+    --rootfs-libc "$W/absent" --lib "$W/old.so" --allow-unverified
+check 1 "but a real problem is still a refusal even with --allow-unverified" \
+    --rootfs-libc "$W/absent" --lib "$W/new.so" --rootfs-libdir "$W/nope" --allow-unverified
+
+# ---- the package-shape gate ---------------------------------------------------------------------
+# It reads the limits out of DriverArchivePolicy.java instead of carrying its own, so this fixture is
+# also the test that the parsing still matches the Java source. If a constant is renamed the script
+# must say so loudly, which is what the last case checks with a policy file that is not the real one.
+mkdir -p "$W/stage"
+python3 - "$W" <<'FIX'
+import json, os, pathlib, sys, zipfile
+w = pathlib.Path(sys.argv[1]); stage = w / "stage"
+(stage / "libvulkan_lvp.so").write_bytes(b"\x7fELF" + b"\0" * 400)
+(stage / "libLLVM.so.19.1").write_bytes(b"\x7fELF" + b"\0" * 400)
+(stage / "NOTICE.txt").write_text("notice\n")
+(stage / "meta.json").write_text(json.dumps({
+    "kind": "linux-vulkan-icd", "libraryName": "libvulkan_lvp.so",
+    "companions": ["libLLVM.so.19.1"]}, indent=2))
+with zipfile.ZipFile(w / "good.zip", "w") as z:
+    for n in sorted(os.listdir(stage)):
+        z.write(stage / n, n)
+(stage / "libstray.so").write_bytes(b"\x7fELF")
+with zipfile.ZipFile(w / "stray.zip", "w") as z:
+    for n in sorted(os.listdir(stage)):
+        z.write(stage / n, n)
+FIX
+POLICY=app/src/main/java/com/droiddeck/launcher/gpu/DriverArchivePolicy.java
+[ -f "$POLICY" ] || POLICY="$HERE/../../$POLICY"
+if python3 "$HERE/check_sizes.py" --archive "$W/good.zip" --stage "$W/stage" --policy "$POLICY" \
+        --zip "$W/good.zip" >"$W/o" 2>&1 && grep -qF "**OK**" "$W/o"; then
+    ok "a declared package passes the size and contents gate"
+else
+    fail "a declared package passes the size and contents gate"; sed 's/^/       /' "$W/o"
+fi
+python3 "$HERE/check_sizes.py" --archive "$W/good.zip" --stage "$W/stage" --policy "$POLICY" \
+    --zip "$W/stray.zip" >"$W/o" 2>&1; st=$?
+if [ "$st" = 1 ] && grep -q "libstray.so is in the zip but not declared" "$W/o"; then
+    ok "an undeclared library in the archive is refused, and names itself"
+else
+    fail "an undeclared library in the archive is refused (exit $st)"; sed 's/^/       /' "$W/o"
+fi
+printf 'class P { }\n' > "$W/Fake.java"
+python3 "$HERE/check_sizes.py" --archive "$W/good.zip" --stage "$W/stage" --policy "$W/Fake.java" \
+    >"$W/o" 2>&1; st=$?
+if [ "$st" != 0 ] && grep -q "could not read MAX_ARCHIVE_BYTES" "$W/o"; then
+    ok "and it refuses to invent the limits when the Java source changes shape"
+else
+    fail "and it refuses to invent the limits"; sed 's/^/       /' "$W/o"
+fi
+
+# ---- the archive-shape gate and the minGlibc recorder -------------------------------------------
+# The fixture's meta.json is missing the fields the last two cases refuse, so fill them in first and
+# check that a complete package passes, then break one field at a time.
+python3 - "$W" <<'FIX2'
+import json, os, pathlib, sys, zipfile
+w = pathlib.Path(sys.argv[1]); stage = w / "stage2"
+stage.mkdir(exist_ok=True)
+(stage / "libvulkan_lvp.so").write_bytes(b"\x7fELF")
+(stage / "libLLVM.so.19.1").write_bytes(b"\x7fELF")
+(stage / "meta.json").write_text(json.dumps({
+    "kind": "linux-vulkan-icd", "name": "t", "libraryName": "libvulkan_lvp.so",
+    "companions": ["libLLVM.so.19.1"], "libc": "glibc", "minGlibc": "2.39",
+    "vulkanApiVersion": "1.3.204"}))
+with zipfile.ZipFile(w / "full.zip", "w") as z:
+    for n in sorted(os.listdir(stage)):
+        z.write(stage / n, n)
+meta = json.loads((stage / "meta.json").read_text()); meta["minGlibc"] = ""
+(stage / "meta.json").write_text(json.dumps(meta))
+with zipfile.ZipFile(w / "nomin.zip", "w") as z:
+    for n in sorted(os.listdir(stage)):
+        z.write(stage / n, n)
+meta["minGlibc"] = "2.39"; meta["companions"] = []
+(stage / "meta.json").write_text(json.dumps(meta))
+with zipfile.ZipFile(w / "undecl.zip", "w") as z:
+    for n in sorted(os.listdir(stage)):
+        z.write(stage / n, n)
+FIX2
+for case in "full.zip:0" "nomin.zip:1" "undecl.zip:1"; do
+    z=${case%%:*}; want=${case##*:}
+    python3 "$HERE/check_archive.py" "$W/$z" >"$W/o" 2>&1; st=$?
+    if [ "$st" = "$want" ]; then ok "check_archive: $z exits $want as expected"
+    else fail "check_archive: $z (exit $st, wanted $want)"; sed 's/^/       /' "$W/o"; fi
+done
+grep -q "not a version" "$W/o" 2>/dev/null || true
+python3 "$HERE/check_archive.py" "$W/undecl.zip" 2>&1 | grep -qF "libLLVM.so.19.1 is in the archive but undeclared" \
