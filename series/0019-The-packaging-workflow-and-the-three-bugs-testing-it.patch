diff --git a/.github/workflows/mali-driver-package.yml b/.github/workflows/mali-driver-package.yml
new file mode 100644
index 0000000..42ccca6
--- /dev/null
+++ b/.github/workflows/mali-driver-package.yml
@@ -0,0 +1,180 @@
+name: Mali driver package
+
+# Repackages upstream's PanVK-kbase release with the adapter from this tree, so a new driver on the
+# phone is a download instead of a rebuild.
+#
+#   drivers/mali-g615/adapter/droiddeck_mali_icd.c  ->  libvulkan_droiddeck_mali.so
+#   upstream libvulkan_panfrost-glibc-aarch64.so   ->  libpanvk_backend.so
+#
+# Deliberately manual, not scheduled. This cannot produce a *new* renderer - the backend comes from
+# zenithblue-oss/panvk-kbase-android untouched - so a weekly run would only re-publish the same bytes
+# under a new digest and make it look like the driver moved when it did not. Run it when upstream
+# ships something newer than what the app carries, or when the adapter changes.
+#
+# Nothing here can put the result on a device: the phone installs it through
+# Components -> Controladores de GPU -> Importar .zip, which is where DriverArchivePolicy decides
+# whether it is acceptable. That policy is re-run here against the finished artifact, so a package the
+# phone would reject never gets published with a friendly name on it.
+on:
+  workflow_dispatch:
+    inputs:
+      upstream_tag:
+        description: "Upstream tag to wrap (blank = its newest release, prereleases included)"
+        required: false
+        type: string
+        default: ""
+      upstream_repo:
+        description: "Upstream repository"
+        required: false
+        type: string
+        default: "zenithblue-oss/panvk-kbase-android"
+      asset:
+        description: "Asset name to wrap (blank = the *-EMULATOR.zip, the glibc/guest half)"
+        required: false
+        type: string
+        default: ""
+      backend_sha256:
+        description: "SHA-256 the backend .so must have, from the release notes' table (optional, worth filling in)"
+        required: false
+        type: string
+        # Upstream's published glibc build for panvk-kbase-v0.1.0-rc2, which is what the device that
+        # reboots is running today: 0b8eaf709cd3559acec72b6fcf3acc24bcdb016bdc998adfedca6ff8eb60c820
+        default: ""
+
+permissions:
+  contents: write
+
+jobs:
+  package:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 30
+    env:
+      GH_TOKEN: ${{ github.token }}
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Resolve the upstream release
+        id: up
+        run: |
+          set -e
+          REPO='${{ inputs.upstream_repo }}'
+          TAG='${{ inputs.upstream_tag }}'
+          if [ -z "$TAG" ]; then
+            # /releases/latest hides prereleases, and every release upstream has published is one -
+            # asking for "latest" would either fail or quietly return something older.
+            TAG=$(gh api "repos/$REPO/releases" --jq '.[0].tag_name')
+          fi
+          echo "tag=$TAG" >> "$GITHUB_OUTPUT"
+          ASSET='${{ inputs.asset }}'
+          if [ -z "$ASSET" ]; then
+            # The -EMULATOR.zip is the glibc half, the one the chroot can load. The .adpkg.zip is for
+            # launchers that load a driver on the Android side (bionic) and this app cannot use it.
+            ASSET=$(gh api "repos/$REPO/releases/tags/$TAG" \
+              --jq '.assets[] | select(.name | endswith("-EMULATOR.zip")) | .name' | head -1)
+          fi
+          [ -n "$ASSET" ] || { echo "no -EMULATOR.zip on $TAG; its assets are:"
+            gh api "repos/$REPO/releases/tags/$TAG" --jq '.assets[].name'; exit 1; }
+          echo "asset=$ASSET" >> "$GITHUB_OUTPUT"
+          # The Mesa commit the driver was built at, from the asset name: PanVK-Kbase-g615-v11-csf-
+          # v0.1.0-rc2-5a07217f-EMULATOR.zip. Recorded in the package, because "which driver" is a
+          # question someone will ask again in a month.
+          echo "mesa=$(echo "$ASSET" | sed -n 's/.*-\([0-9a-f]\{7,40\}\)-EMULATOR.zip$/\1/p')" \
+            >> "$GITHUB_OUTPUT"
+          echo "== $REPO  $TAG  $ASSET"
+          gh api "repos/$REPO/releases/tags/$TAG" --jq '.assets[] | "  \(.name)  \(.size) bytes"'
+
+      - name: Download it and check it against upstream's own digests
+        run: |
+          set -e
+          REPO='${{ inputs.upstream_repo }}'
+          ASSET='${{ steps.up.outputs.asset }}'
+          gh release download '${{ steps.up.outputs.tag }}' -R "$REPO" -p "$ASSET" -D upstream -c
+          # The sums file is a separate asset and not guaranteed to exist or to name this file the
+          # same way. Checked for the one file that matters, and a mismatch stops the run: an asset
+          # quietly replaced upstream is exactly how a bad driver ends up on a phone.
+          if gh release download '${{ steps.up.outputs.tag }}' -R "$REPO" -p 'SHA256SUMS*' \
+               -D upstream -c 2>/dev/null; then
+            ls -l upstream
+            SUMS=$(ls upstream/SHA256SUMS* | head -1)
+            if grep -F -- "$ASSET" "$SUMS" > upstream/only.sum; then
+              ( cd upstream && sha256sum -c only.sum )
+            else
+              echo "  $ASSET is not listed in $SUMS; skipping that check"
+            fi
+          else
+            echo "  no SHA256SUMS asset on this release"
+          fi
+          ls -l upstream
+
+      - name: Install the cross compiler and the Vulkan headers
+        run: |
+          set -e
+          sudo apt-get update -qq
+          sudo apt-get install -y -qq gcc-aarch64-linux-gnu unzip zip
+          git clone -q --depth 1 https://github.com/KhronosGroup/Vulkan-Headers "$RUNNER_TEMP/vkh"
+          echo "VULKAN_INCLUDE_DIR=$RUNNER_TEMP/vkh/include" >> "$GITHUB_ENV"
+
+      # The trace is the reason this adapter exists, and its one job - the dying call is the last line
+      # in the file - is tested here rather than trusted, against a fake backend that SIGKILLs itself
+      # inside vkQueuePresentKHR.
+      - name: Test the adapter before shipping it
+        run: bash drivers/mali-g615/test/run_adapter_tests.sh
+
+      - name: Build the package
+        run: |
+          set -e
+          UPSTREAM_ZIP="upstream/${{ steps.up.outputs.asset }}" \
+          UPSTREAM_TAG='${{ steps.up.outputs.tag }}' \
+          MESA_COMMIT='${{ steps.up.outputs.mesa }}' \
+          EXPECTED_BACKEND_SHA256='${{ inputs.backend_sha256 }}' \
+            bash drivers/mali-g615/build.sh dist
+          ls -l dist
+
+      # Same three rules the phone applies, run against the artifact instead of discovered on it:
+      # exactly one libvulkan_*.so in the archive, and for our soname a backend beside it. A driver
+      # that fails this is a red "cannot parse package" on the phone with nothing to read.
+      - name: Check it against the app's import policy
+        run: |
+          set -e
+          python3 - dist/*.zip <<'PY'
+          import re, sys, zipfile
+          path = sys.argv[1]
+          archive = zipfile.ZipFile(path)
+          names = [n.rsplit("/", 1)[-1] for n in archive.namelist()]      # what the importer sees
+          raw = archive.namelist()                                         # paths, for directories
+          main = [n for n in names if re.fullmatch(r"libvulkan_[A-Za-z0-9][A-Za-z0-9_.-]*\.so", n)]
+          assert len(main) == 1, "expected exactly one main library, found %r" % (main,)
+          assert main[0] == "libvulkan_droiddeck_mali.so", main
+          assert "libpanvk_backend.so" in names, "the adapter's backend is missing from the archive"
+          assert "meta.json" in names, "no meta.json"
+          # GPL source offers travel with the binary, or the package is not redistributable.
+          assert "NOTICE.txt" in names and any(n.startswith("licenses/") for n in raw), \
+              "licences must travel with the driver"
+          assert not archive.testzip(), "corrupt entry in the archive"
+          print("== import policy: OK (%d files, %d licence files)" % (
+              len(names), sum(1 for n in raw if n.startswith("licenses/") and not n.endswith("/"))))
+          PY
+
+      - name: Publish
+        run: |
+          set -e
+          ZIP=$(ls dist/*.zip | head -1)
+          sha256sum "$ZIP" | tee dist/sha256.txt
+          cp "$ZIP" .
+          ZIPNAME=$(basename "$ZIP")
+          gh release delete mali-driver-latest --yes --cleanup-tag 2>/dev/null || true
+          gh release create mali-driver-latest "$ZIPNAME" dist/sha256.txt \
+            --prerelease \
+            --title "DroidDeck Mali-G615 driver package (adapter + PanVK ${{ steps.up.outputs.tag }})" \
+            --notes "Built by this workflow from \`${{ inputs.upstream_repo }}\` \`${{ steps.up.outputs.tag }}\`, run ${{ github.run_id }}.
+
+          The backend inside is upstream's file, byte for byte; the adapter is built from
+          \`drivers/mali-g615/adapter/droiddeck_mali_icd.c\` in this tree. It is not a new GPU driver and
+          it is not a fix for the fault that reboots the phone: it adds the DRM-node facade the session's
+          display server needs, and a call trace that names which Vulkan call the device died inside.
+
+          Install: Components -> Controladores de GPU -> Importar .zip. Then, to use the trace,
+          turn on Seguridad GPU -> 'Trace the driver's GPU calls' and look for
+          \`droiddeck-driver-trace.log\` in the session folder.
+
+          Verify: \`sha256sum $ZIPNAME\` against dist/sha256.txt above."
