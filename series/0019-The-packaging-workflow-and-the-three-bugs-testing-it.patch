@@ -39,3 +39,7 @@ __pycache__/
 # Local signing with the release key (tools/build_local.sh); holds a password.
 .signing.env
 app/src/main/assets/directaudio/
+
+# Driver packages built by drivers/mali-g615/build.sh - the 21 MB backend is
