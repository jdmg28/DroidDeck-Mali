 .../overlay/usr/local/bin/droiddeck-session   |  46 ++++++-
 tools/test/run_software_session_tests.sh      | 120 ++++++++++++++++++
 3 files changed, 175 insertions(+), 3 deletions(-)
 create mode 100644 tools/test/run_software_session_tests.sh

diff --git a/app/src/main/java/com/droiddeck/launcher/session/SessionService.kt b/app/src/main/java/com/droiddeck/launcher/session/SessionService.kt
index 552a6be..8e17f5d 100644
--- a/app/src/main/java/com/droiddeck/launcher/session/SessionService.kt
+++ b/app/src/main/java/com/droiddeck/launcher/session/SessionService.kt
@@ -757,8 +757,18 @@ class SessionService : Service() {
         val linuxDriverId = SessionPrefs.linuxDriver(this)
         // Software mode overrides it; see LinuxVulkanDriver.driverForSession. An empty result is not
         // "fall back", it is "no driver", and the guest script is written to honour that.
-        LinuxVulkanDriver.resolveIcdPath(this, LinuxVulkanDriver.driverForSession(this, linuxDriverId))
+        val sessionDriverId = LinuxVulkanDriver.driverForSession(this, linuxDriverId)
+        LinuxVulkanDriver.resolveIcdPath(this, sessionDriverId)
             ?.let { guest.add(LinuxVulkanDriver.ENV + "=" + it) }
+        // What that driver said it needs, in the one mode where a wrong answer wastes an evening. The
+        // guest has the manifest but not the meta.json beside it (only the manifest's path is bound),
+        // so the number travels here; droiddeck-session compares it against `getconf
+        // GNU_LIBC_VERSION` before anything is pointed at the ICD.
+        if (guardProfile.avoidsGpu && sessionDriverId.isNotEmpty()) {
+            LinuxVulkanDriverManager(this).getMinGlibc(sessionDriverId)
+                .takeIf { it.isNotEmpty() }
+                ?.let { guest.add("BL_DRIVER_MIN_GLIBC=" + it) }
+        }
         // Turnip's own debug switches, for the runtime's driver and everything on it. The file in
         // Downloads holds the value verbatim ("sysmem", "sysmem,deck_emu"); with nothing there, an
         // imported driver from the A710/A720/A722 legs gets "sysmem" on its own, which is what both
diff --git a/tools/linuxfs/overlay/usr/local/bin/droiddeck-session b/tools/linuxfs/overlay/usr/local/bin/droiddeck-session
index bbc92f9..61e0849 100755
--- a/tools/linuxfs/overlay/usr/local/bin/droiddeck-session
+++ b/tools/linuxfs/overlay/usr/local/bin/droiddeck-session
@@ -13,6 +13,24 @@ shift || true
 # One line per milestone, greppable as "== STEP", so a first run reads as a narrative rather than
 # something to be reconstructed from Steam's own chatter. The app shows these while it waits.
 step() { echo "== STEP $(date -u +%H:%M:%S) $*"; }
+
+# "Is version A at least B", for the two-part versions both sides here actually use (glibc 2.39, a
+# driver's declared minimum 2.38). A missing or non-numeric minor counts as 0, which is the only
+# reading that keeps "2.4" from being treated as older than "2.39" by accident... and "2.40" is newer
+# than "2.9" here, which string comparison would have got wrong.
+dd_at_least() {
+  _a1=${1%%.*}; _a2=${1#*.}
+  _b1=${2%%.*}; _b2=${2#*.}
+  [ "$_a2" = "$1" ] && _a2=0
+  [ "$_b2" = "$2" ] && _b2=0
+  case $_a2 in ''|*[!0-9]*) _a2=0;; esac
+  case $_b2 in ''|*[!0-9]*) _b2=0;; esac
+  case $_a1 in ''|*[!0-9]*) return 1;; esac
+  case $_b1 in ''|*[!0-9]*) return 1;; esac
+  [ "$_a1" -gt "$_b1" ] && return 0
+  [ "$_a1" -lt "$_b1" ] && return 1
+  [ "$_a2" -ge "$_b2" ]
+}
 if [ -n "${BL_LOG:-}" ] && [ -z "${BL_INSIDE:-}" ]; then
   mkdir -p "$(dirname "$BL_LOG")" 2>/dev/null
   # The client alone writes megabytes an hour; one earlier log is kept, not every session's.
@@ -92,10 +110,34 @@ if [ "${BL_SOFTWARE_VULKAN:-}" = 1 ]; then
          ".zip). The session is refused rather than started on the GPU."
     exit 78
   fi
+  # The one thing a driver zip can get wrong that nothing here would notice: it is built against a
+  # newer glibc than this rootfs has. The loader's answer is not an error anyone reads - the ICD is
+  # skipped, the device list comes up empty, and the session dies on a Vulkan init failure thirty
+  # seconds later. So the version the package was measured against travels with it (the importer keeps
+  # it from meta.json, CI records it by reading the libraries) and is compared here, against the
+  # glibc this guest really has. An unknown glibc is not a known-old one: that case is reported and
+  # allowed, because refusing on a missing getconf would punish rootfs images that are fine.
+  bl_need=$(printf '%s' "${BL_DRIVER_MIN_GLIBC:-}" | sed -n 's/^\([0-9][0-9.]*\).*/\1/p')
+  bl_have=$(getconf GNU_LIBC_VERSION 2>/dev/null | sed -n 's/^[^0-9]*\([0-9][0-9.]*\).*/\1/p')
+  case $bl_need in *.*) ;; ?*) bl_need="$bl_need.";; '' ) ;; esac
+  case $bl_have in *.*) ;; ?*) bl_have="$bl_have.";; esac
+  bl_note="no minimum glibc declared by the package, so the runtime was not checked"
+  if [ -n "$bl_need" ]; then
+    if [ -z "$bl_have" ]; then
+      bl_note="wants glibc $bl_need and this rootfs reported none (musl, or no getconf) - continuing"
+    elif ! dd_at_least "$bl_have" "$bl_need"; then
+      echo "DD_SOFTWARE_GLIBC_OLD: this rootfs has glibc $bl_have and the software driver was built for" \
+           "$bl_need or newer. Refused instead of starting a session whose Vulkan device list would come" \
+           "up empty; the fix is a newer rootfs image, not a different setting in this app."
+      exit 78
+    else
+      bl_note="glibc $bl_have is at least the $bl_need the driver was built for"
+    fi
+  fi
   export VK_DRIVER_FILES="$BL_VK_DRIVER"
   export VK_ICD_FILENAMES="$BL_VK_DRIVER"
-  echo "== vulkan driver: software only, $bl_soft_lib"
-  unset bl_soft_lib
+  echo "== vulkan driver: software only, $bl_soft_lib ($bl_note)"
+  unset bl_soft_lib bl_need bl_have bl_note
 fi
 if [ "${BL_GPU_FAMILY:-}" = mali ] && [ "${BL_SOFTWARE_VULKAN:-}" != 1 ] && [ -z "${BL_VK_DRIVER:-}" ]; then
   echo "DD_MALI_DRIVER_REQUIRED: import/select the Linux PanVK package; Turnip cannot run on Mali"
diff --git a/tools/test/run_software_session_tests.sh b/tools/test/run_software_session_tests.sh
new file mode 100644
index 0000000..69b401f
--- /dev/null
+++ b/tools/test/run_software_session_tests.sh
@@ -0,0 +1,120 @@
+#!/usr/bin/env bash
+# Tests for the software-mode part of droiddeck-session - run for real, in a shell, against fixtures.
+#
+# The session script as a whole cannot be run here: it wants the guest rootfs, proot, gamescope and a
+# display. But the branch that decides whether a software-mode session starts or refuses is pure shell
+# over three files and two variables, so it can be cut out of the script and executed. That is worth the
+# extraction because the failure this branch exists to prevent is a *silent* one: an unreadable driver
+# that falls back to the runtime's own ICD would put the GPU back into a session that promised it
+# wouldn't, and only the phone would notice.
+#
+# The markers below are the extraction contract. If the script is ever rearranged, this test fails with
+# "the script moved" rather than quietly testing nothing - which is the only way a structural test can
+# be trusted.
+set -u
+HERE="$(cd "$(dirname "$0")" && pwd)"
+SCRIPT="$HERE/../linuxfs/overlay/usr/local/bin/droiddeck-session"
+W="$(mktemp -d)"; trap 'rm -rf "$W"' EXIT
+FAILED=0
+ok()   { echo "  ok   $1"; }
+fail() { echo "  FAIL $1"; FAILED=1; }
+
+# ---- extract the block ----------------------------------------------------------------------------
+python3 - "$SCRIPT" "$W/block.sh" <<'PY'
+import sys
+src, out = sys.argv[1], sys.argv[2]
+text = open(src, encoding="utf-8", errors="replace").read()
+start = text.find("dd_at_least() {")
+begin = text.find('if [ "${BL_SOFTWARE_VULKAN:-}" = 1 ]; then')
+end = text.find('if [ "${BL_GPU_FAMILY:-}" = mali ] && [ "${BL_SOFTWARE_VULKAN:-}" != 1 ]'
+               ' && [ -z "${BL_VK_DRIVER:-}" ]')
+if min(start, begin) < 0 or end < 0 or not (start < begin < end):
+    sys.exit("the software-mode block is not where this test expects it in droiddeck-session: "
+             "markers at %s/%s/%s. Update the test with the script, never by relaxing the assertion."
+             % (start, begin, end))
+body = text[start:end].rstrip() + '\n'
+# What the script would have done next, so the test can see the effect rather than only the message.
+# The probe reports whether the loader was pointed anywhere, as a single token: echoing the value
+# itself would print "none" for the cases where the block correctly did nothing, and a test that
+# passes on both is not a test.
+body += 'echo "PROBE exported=${VK_DRIVER_FILES+yes}${VK_ICD_FILENAMES+yes}"\nexit 0\n'
+open(out, "w", encoding="utf-8").write(
+    "set -u\n# extracted from droiddeck-session for testing; see the header of this test\n" + body)
+PY
+[ -f "$W/block.sh" ] || { echo "extraction failed"; exit 1; }
+
+# A guest whose getconf says what we tell it, and one that says nothing at all.
+make_getconf() {
+  mkdir -p "$W/$1/bin"
+  if [ "$2" = none ]; then printf '#!/bin/sh\nexit 1\n' > "$W/$1/bin/getconf"
+  else printf '#!/bin/sh\necho "glibc %s"\n' "$2" > "$W/$1/bin/getconf"; fi
+  chmod +x "$W/$1/bin/getconf"
+}
+make_getconf g239 2.39
+make_getconf g228 2.28
+make_getconf gnone none
+
+# A driver directory in the shape the importer leaves it: icd.json naming its library beside itself.
+make_driver() {
+  local d="$W/$1"
+  mkdir -p "$d"
+  : > "$d/libvulkan_lvp.so"
+  printf '{\n    "file_format_version": "1.0.1",\n    "ICD": {\n        "library_path": "\\/%s\\/libvulkan_lvp.so",\n        "api_version": "1.3.204"\n    }\n}\n' \
+    "${d#/}" > "$d/icd.json"
+  echo "$d"
+}
+DRV=$(make_driver driver)
+BROKEN=$(make_driver broken)
+rm -f "$BROKEN/libvulkan_lvp.so"
+
+# run <label> <getconf-dir> <expect-exit> <expect-substring...> with BL_* in the environment
+run() {
+  local label="$1" conf="$2" want="$3"; shift 3
+  local out status
+  out=$(PATH="$W/$conf/bin:$PATH" \
+        BL_SOFTWARE_VULKAN="${SOFT:-1}" BL_VK_DRIVER="${ICD-$DRV/icd.json}" \
+        BL_DRIVER_MIN_GLIBC="${NEED:-}" \
+        bash "$W/block.sh" 2>&1); status=$?
+  if [ "$status" != "$want" ]; then
+    fail "$label (exit $status, wanted $want)"; printf '%s\n' "$out" | sed 's/^/       /'; return
+  fi
+  local bad=0
+  for needle in "$@"; do
+    # A leading ! means "must not appear", which is how the refusals are proved: not that they said
+    # something, but that the export they were refusing never happened.
+    case $needle in
+      \!*) printf '%s\n' "$out" | grep -qF -- "${needle#!}" \
+             && { bad=1; echo "       must not appear: ${needle#!}"; } ;;
+      *)   printf '%s\n' "$out" | grep -qF -- "$needle" \
+             || { bad=1; echo "       missing: $needle"; } ;;
+    esac
+  done
+  if [ "$bad" = 0 ]; then ok "$label"; else FAILED=1; printf '%s\n' "$out" | sed 's/^/       /'; fi
+}
+
+# ---- the cases ------------------------------------------------------------------------------------
+NEED=2.38 run "a rootfs new enough for the driver starts, naming both versions" g239 0 \
+    "== vulkan driver: software only" "glibc 2.39 is at least the 2.38 the driver was built for" \
+    "PROBE exported=yesyes"
+# The loader is pointed at exactly the manifest we handed in - that equality is what keeps the
+# runtime's own PanVK manifest out of the enumeration, so it is asserted, not assumed.
+NEED=2.50 run "a rootfs too old is refused before anything is exported" g228 78 \
+    "DD_SOFTWARE_GLIBC_OLD" "glibc 2.28" "built for 2.50"
+NEED=2.50 run "  ...and the refusal happens before the loader is pointed anywhere" g228 78 "!exported=yes"
+SOFT=0 run "software mode off means this branch does not run at all" g239 0 "!software only" "!exported=yes"
+NEED= run "a package that declares no minimum glibc says so and continues" g239 0 \
+    "no minimum glibc declared"
+ICD=$DRV/icd.json NEED=2.39 run "equal versions are enough (>=, not >)" g239 0 "at least the 2.39"
+ICD=$BROKEN/icd.json NEED=2.38 run "an unreadable library is refused, not fallen back from" g239 78 \
+    "DD_SOFTWARE_DRIVER_MISSING"
+ICD=$BROKEN/icd.json NEED=2.38 run "  ...even when the rootfs glibc is fine, and says what to import" g239 78 \
+    "libvulkan_lvp.so"
+ICD= NEED=2.38 run "no driver at all is a refusal too, in every ordering" g239 78 \
+    "DD_SOFTWARE_DRIVER_MISSING"
+ICD=$DRV/icd.json NEED=2.38 run "a rootfs that reports no glibc is a note, not a refusal" gnone 0 \
+    "reported none" "software only" "!DD_SOFTWARE_GLIBC_OLD"
+ICD=$DRV/icd.json NEED=2.38 run "and a musl-style runtime still gets the driver exported" gnone 0 \
+    "PROBE exported=yesyes"
+
+[ "$FAILED" = 0 ] && echo "all software-mode session cases passed" || echo "SOFTWARE-MODE SESSION TESTS FAILED"
+exit "$FAILED"
-- 
2.39.5

